    """Green for successful results, red for failed ones (if `red`), else base."""
    t = text.lower()
    if any(x in t for x in theme_BAD_WORDS):
        return theme_BAD_BAR if red else base
    if any(x in t for x in theme_GOOD_WORDS):
        return theme_GOOD_BAR
    return base


