READY = b'Server listening on'
START_TIMEOUT = 25.0


def available() -> bool:
    """True on a machine where the local radio can be started."""
    return (os.path.exists(SPIDEV) and os.path.isfile(PI_PYTHON) and os.path.isfile(PI_CONFIG)
            and os.path.isfile(os.path.join(PI_DIR, 'meshcore.py')))


def _pi_env() -> dict:
    # meshcore-pi does sys.path.append("./lib/pure25519"), relative to the cwd; we run it from HOME_DIR
    libs = [os.path.join(PI_DIR, 'lib', 'pure25519'), os.path.join(PI_DIR, 'lib', 'ESPythoNOW')]
    return dict(os.environ, PYTHONPATH=os.pathsep.join(libs + [os.environ.get('PYTHONPATH', '')]).rstrip(os.pathsep))


def _set_5v(on: bool):
    try:
        with open(LED_5V, 'w') as f:
            f.write('255' if on else '0')
    except OSError:
        pass                              # no such LED (not a Cardputer) or no permission


CAP_I2C, CAP_EXPANDER = '/dev/i2c-1', 0x43       # the Cap LoRa-1262's PI4IOE5V6408 I/O expander


def _expander_io(fd: int):
    def rd(reg: int) -> int:
        os.write(fd, bytes([reg]))
        return os.read(fd, 1)[0]

    def wr(reg: int, value: int):
        os.write(fd, bytes([reg, value]))
    return rd, wr


def cap_antenna_on() -> dict | None:
    """Switch the Cap LoRa-1262's antenna switch on: pin P0 of its PI4IOE5V6408 expander must be an output driven high
    (M5Stack's own app does the same). meshcore-pi never touches the expander, and with P0 left as a pulled-down input the
    link was 10 to 15 dB weaker. Only P0 is changed. Returns the registers to restore, or None (no Cap, or no expander)."""
    import fcntl
    try:
        fd = os.open(CAP_I2C, os.O_RDWR)
    except OSError:
        return None
    try:
        fcntl.ioctl(fd, 0x0703, CAP_EXPANDER)                 # I2C_SLAVE
        rd, wr = _expander_io(fd)
        for attempt in range(10):                             # the expander needs a moment after the 5V rail comes on
            try:
                ident = rd(0x01)
                break
            except OSError:
                if attempt == 9:
                    return None
                time.sleep(0.05)
        if ident & 0xfc != 0xa0:
            log.warning('Cap expander at 0x%02x did not identify itself (id 0x%02x); antenna switch left alone', CAP_EXPANDER, ident)
            return None
        saved = {reg: rd(reg) for reg in (0x03, 0x05, 0x07, 0x0b)}
        for reg, value in ((0x05, saved[0x05] | 1), (0x0b, saved[0x0b] & ~1),         # latch high first, no pull on P0,
                           (0x03, saved[0x03] | 1), (0x07, saved[0x07] & ~1)):        # then make it an active output
            wr(reg, value)
        if not (rd(0x05) & 1 and rd(0x03) & 1 and not rd(0x07) & 1):
            log.warning('Cap antenna switch: P0 did not read back as an output driven high')
            return None
        log.info('Cap LoRa-1262 antenna switch on (expander P0 high)')
        return saved
    except OSError as e:
        log.warning('Cap antenna switch: %s', e)
        return None
    finally:
        os.close(fd)


def cap_antenna_off(saved: dict | None):
    if not saved:
        return
    try:
        fd = os.open(CAP_I2C, os.O_RDWR)
    except OSError:
        return
    try:
        import fcntl
        fcntl.ioctl(fd, 0x0703, CAP_EXPANDER)
        rd, wr = _expander_io(fd)
        wr(0x07, rd(0x07) | 1)                                 # P0 off the pin first, then put the rest back
        for reg in (0x05, 0x0b, 0x03, 0x07):
            wr(reg, (rd(reg) & ~1) | (saved[reg] & 1))
    except OSError:
        pass                                                   # the rail may already be off
    finally:
        os.close(fd)


def _port_free() -> bool:
    with socket.socket() as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind((HOST, PORT))
        except OSError:
            return False
    return True


def _die_with_parent():
    # if the app is killed outright, don't leave meshcore-pi hogging SPI and a CPU core
    try:
        ctypes.CDLL('libc.so.6', use_errno=True).prctl(1, signal.SIGTERM)   # PR_SET_PDEATHSIG
    except Exception:
        pass


def _tail(path: str, start: int, lines: int = 3) -> str:
    try:
        with open(path, 'rb') as f:
            f.seek(start)
            text = f.read().decode(errors='replace')
    except OSError:
        return ''
    return ' | '.join(text.strip().splitlines()[-lines:])



NBSP = '\u00a0'


def blank(n: int) -> str:
    """Highlighted filler for popups. Plain spaces in reverse video get wiped by ncurses with an erase
    sequence, which on terminals with back-color-erase (st) paints the background instead of the highlight."""
    return NBSP * n


def pad(s: str, n: int) -> str:
    return s + NBSP * max(0, n - len(s))


class LocalRadio:
    def __init__(self):
        self.proc = None
        self.cap = None                   # the expander registers to restore (see cap_antenna_on)

    async def start(self):
        # A start right after another radio was stopped can find the GPIO lines still claimed; meshcore-pi
        # then keeps running with a half-configured radio (it never completes a transmit). Detect and retry.
        for attempt in range(3):
            try:
                return await self._start_once()
            except RuntimeError as e:
                if attempt == 2 or 'already in use' in str(e) or 'not available' in str(e):
                    raise
                await asyncio.sleep(3)

    async def _start_once(self):
        if not available():
            raise RuntimeError(f'local radio not available (need {SPIDEV}); run: {APP} install')
        if not _port_free():
            raise RuntimeError(f'port {PORT} already in use (is meshcore-pi already running?)')
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        start_at = os.path.getsize(LOG_FILE) if os.path.exists(LOG_FILE) else 0
        _set_5v(True)
        await asyncio.sleep(0.2)
        self.cap = await asyncio.to_thread(cap_antenna_on)
        try:
            with open(LOG_FILE, 'ab') as log:
                self.proc = await asyncio.create_subprocess_exec(
                    PI_PYTHON, os.path.join(PI_DIR, 'meshcore.py'), PI_CONFIG, cwd=HOME_DIR, env=_pi_env(),
                    stdin=asyncio.subprocess.DEVNULL, stdout=log, stderr=log,
                    start_new_session=True, preexec_fn=_die_with_parent)
            # meshcore-pi writes its own meshcore.log (in HOME_DIR); its stdout/stderr (tracebacks) land in LOG_FILE.
            # Ready = the companion server is listening, which it logs to meshcore.log.
            pi_log = os.path.join(HOME_DIR, 'meshcore.log')
            pi_start = os.path.getsize(pi_log) if os.path.exists(pi_log) else 0
            loop = asyncio.get_running_loop()
            deadline = loop.time() + START_TIMEOUT
            while loop.time() < deadline:
                if self.proc.returncode is not None:
                    detail = _tail(LOG_FILE, start_at) or _tail(pi_log, pi_start, 1)
                    raise RuntimeError(f'meshcore-pi exited ({self.proc.returncode}): {detail}')
                try:
                    with open(pi_log, 'rb') as f:
                        f.seek(0 if os.path.getsize(pi_log) < pi_start else pi_start)
                        text = f.read()
                    if b'Unable to configure interface' in text:
                        raise RuntimeError('meshcore-pi could not set up the radio (GPIO busy?)')
                    if READY in text:
                        await asyncio.sleep(0.3)
                        return
                except OSError:
                    pass
                await asyncio.sleep(0.25)
            raise RuntimeError(f'meshcore-pi did not start within {START_TIMEOUT:.0f}s')
        except BaseException:
            await self.stop()
            raise

    async def stop(self):
        proc, self.proc = self.proc, None
        if proc is not None and proc.returncode is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                await asyncio.wait_for(proc.wait(), 5)
            except asyncio.TimeoutError:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                await proc.wait()
        cap, self.cap = self.cap, None
        await asyncio.to_thread(cap_antenna_off, cap)
        _set_5v(False)


