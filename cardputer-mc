    return 0


def apply_pi_patches():
    """Local fixes on top of the pinned meshcore-pi (MeshCore >= 1.11 path hashes, TX power, ...). The patches are written
    one after the other, so a tree that has them all cannot be told apart patch by patch. Instead: build the expected
    tree (pinned commit + every patch) in a temporary directory; when the tracked files of PI_DIR match it nothing is
    done, otherwise PI_DIR's tracked files are reset to the pinned commit and the patches are applied in order."""
    import shutil
    import tempfile
    patches = (('multi-byte path hashes, RX race', PI_PATCH), ('ACKs with extra bytes', PI_PATCH_ACK),
               ('TX power command (applied between packets, max 22)', PI_PATCH_TX),
               ('binary requests: status, telemetry, neighbours of repeaters', PI_PATCH_BIN),
               ('import contact (meshcore:// links)', PI_PATCH_IMPORT),
               ('radio receive thread sleeps instead of using a whole core', PI_PATCH_RX),
               ('noise floor (CMD_GET_STATS, radio)', PI_PATCH_NOISE),
               ('the ACT led lights up during a transmission', PI_PATCH_LED))
    tmp = tempfile.mkdtemp(prefix='cmc-pi-')
    try:
        tar = subprocess.run(['git', '-C', PI_DIR, 'archive', PI_COMMIT], capture_output=True, check=True).stdout
        subprocess.run(['tar', '-x', '-C', tmp], input=tar, check=True)
        for _name, patch in patches:
            subprocess.run(['git', 'apply', '--whitespace=nowarn', '-'], input=patch, text=True, cwd=tmp, check=True, capture_output=True)
        tracked = subprocess.run(['git', '-C', PI_DIR, 'ls-files'], capture_output=True, text=True, check=True).stdout.split('\n')
        same = True
        for rel in filter(None, tracked):
            try:
                with open(os.path.join(PI_DIR, rel), 'rb') as f1, open(os.path.join(tmp, rel), 'rb') as f2:
                    same = same and f1.read() == f2.read()
            except OSError:
                same = False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    if same:
        print('  all fixes already applied')
        return
    print('  meshcore-pi is not at the expected fixes: resetting its tracked files to the pinned commit first')
    _run(['git', '-C', PI_DIR, 'checkout', '-q', '-f', PI_COMMIT])
    for name, patch in patches:
        subprocess.run(['git', '-C', PI_DIR, 'apply', '--whitespace=nowarn', '-'], input=patch, text=True, check=True)
        print(f'  applied fix: {name}')


def install(argv):
    ap = argparse.ArgumentParser(prog=f'{APP} install', description='Set up meshcore-pi, a venv and a config.')
    ap.add_argument('--name', default='Cardputer', help='node name shown to others (default: Cardputer)')
    ap.add_argument('--key', metavar='HEX', help='existing 32-byte private key (64 hex characters) instead of a new one')
    ap.add_argument('-y', '--yes', action='store_true', help='do not ask before running sudo apt-get')
    ap.add_argument('--client', action='store_true',
                    help='on a machine without the radio (a PC): only a venv with the meshcore library and the command, '
                         f'for use with: {APP} --remote USER@HOST')
    opts = ap.parse_args(argv)
    if opts.client:
        return install_client()
    if opts.key and not re.fullmatch(r'[0-9a-fA-F]{64}', opts.key):
        raise SystemExit('--key must be 64 hex characters')
    _migrate_old_name()
    os.makedirs(HOME_DIR, exist_ok=True)
    if not os.path.exists('/dev/spidev0.1'):
        print('warning: /dev/spidev0.1 not found; is SPI enabled and is this a CardputerZero?')

    print('1/5 apt packages')
    missing = [p for p in APT_PACKAGES
               if subprocess.run(['dpkg', '-s', p], capture_output=True).returncode != 0]
    if missing:
        if not opts.yes and input(f'  sudo apt-get install {" ".join(missing)} ? [Y/n] ').strip().lower() == 'n':
            raise SystemExit('aborted')
        _run(['sudo', 'apt-get', 'install', '-y'] + missing)
    else:
        print('  all present')

    print('2/5 python venv')
    if not os.path.isfile(VENV_PY):
        _run([sys.executable, '-m', 'venv', '--system-site-packages', VENV_DIR])
    pip = [VENV_PY, '-m', 'pip']
    _run(pip + ['install', '--retries', '10', '--timeout', '60', '-q'] + PIP_PACKAGES)
    # LoRaRF pulls in RPi.GPIO, which shadows the rpi-lgpio shim from apt (the Pi 5 style GPIO API)
    subprocess.run(pip + ['uninstall', '-y', '-q', 'RPi.GPIO'], capture_output=True)
    check = subprocess.run([VENV_PY, '-c', 'import RPi.GPIO as G, LoRaRF, meshcore; print(G.__file__)'],
                           capture_output=True, text=True)
    if check.returncode != 0:
        raise SystemExit('python check failed:\n' + check.stderr.strip())
    print('  ok:', check.stdout.strip())

    print('3/5 meshcore-pi (pinned commit + local fixes)')
    if not os.path.isdir(os.path.join(PI_DIR, '.git')):
        _run(['git', 'clone', '-q', PI_REPO, PI_DIR])
    _run(['git', '-C', PI_DIR, 'checkout', '-q', PI_COMMIT])
    apply_pi_patches()

    print('4/5 config')
    if os.path.exists(PI_CONFIG):
        print(f'  keeping existing {PI_CONFIG}')
    else:
        key = (opts.key or os.urandom(32).hex()).lower()
        fd = os.open(PI_CONFIG, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(CONFIG_TEMPLATE.format(name=opts.name.replace('"', ''), key=key))
        print(f'  wrote {PI_CONFIG} (mode 600; contains this node\'s private key)')

    print('5/5 command')
    link_dir = os.path.expanduser('~/.local/bin')
    os.makedirs(link_dir, exist_ok=True)
    link = os.path.join(link_dir, APP)
    target = os.path.realpath(__file__)
    if os.path.realpath(link) != target:
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(target, link)
    print(f'  {link} -> {target}')
    _install_completion()
    print(f'\nDone. Run: {APP}   (make sure ~/.local/bin is on your PATH)')
    return 0


