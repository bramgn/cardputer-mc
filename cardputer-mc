async def ui(scr, app: App):
    curses.curs_set(1)
    theme_init_colors(app.theme)
    scr.nodelay(True)
    scr.keypad(True)
    while not app.quit:
        try:
            k = scr.get_wch()
        except curses.error:
            k = None
        if k is None:
            if app.dirty:
                app.dirty = False
                app.draw(scr)
            await asyncio.sleep(0.03)
            continue
        if k == curses.KEY_RESIZE:
            app.dirty = True
            continue
        await app.handle_key(k)

async def run(scr, args):
    app = App(args)
    if app.auto_connect:
        app.start_auto_connect()
    async def autosave():
        while True:
            await asyncio.sleep(10)
            app.save_history()
    saver = asyncio.create_task(autosave())
    try:
        await ui(scr, app)
    finally:
        saver.cancel()
        app.save_history()
        await app.disconnect()

def main():
    ap = argparse.ArgumentParser(
        prog=APP, description='ncurses MeshCore chat for the M5 CardputerZero with the Cap-LoRa-1262',
        epilog=f'First run: {APP} install   (sets up meshcore-pi, a venv and {PI_CONFIG})')
    ap.add_argument('--version', action='version', version=f'{APP} {__version__}')
    ap.parse_args()
    args = argparse.Namespace()
    locale.setlocale(locale.LC_ALL, '')
    os.environ.setdefault('ESCDELAY', '25')   # ncurses waits 1000ms after Esc by default
    # keep library log output off the screen; F8 shows it
    root = logging.getLogger()
    root.handlers[:] = [LOG]
    root.setLevel(logging.INFO)

    def wrapped(scr):
        asyncio.run(run(scr, args))

    try:
        curses.wrapper(lambda scr: (curses.raw(), wrapped(scr)))
    except KeyboardInterrupt:
        pass
    except Exception as e:
        raise SystemExit(f'{APP}: {type(e).__name__}: {e}')


if __name__ == '__main__':
    main()
