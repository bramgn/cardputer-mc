COMPLETION_FILE = os.path.expanduser('~/.local/share/bash-completion/completions/' + APP)     # loaded on demand by bash-completion


def completion_script(ap: argparse.ArgumentParser) -> str:
    """A bash completion made from the argument parser itself: commands, `radio` actions, options, choices, and contact
    names (from the running radio daemon; nothing is started for it) where a TARGET is expected."""
    def spec(parser):
        opts, choices, target, valued = [], [], False, []
        for a in parser._actions:
            if a.help == argparse.SUPPRESS or isinstance(a, (argparse._HelpAction, argparse._VersionAction, argparse._SubParsersAction)):
                continue
            if a.option_strings:
                opts += a.option_strings
                if a.nargs != 0:
                    valued += a.option_strings
            elif a.choices:
                choices += [str(c) for c in a.choices]
            elif a.dest == 'target':
                target = True
        return opts, choices, target, valued

    def visible(subparsers):
        return [a.dest for a in subparsers._choices_actions]

    top = next(a for a in ap._actions if isinstance(a, argparse._SubParsersAction))
    commands = visible(top)
    glob_opts = [o for a in ap._actions if a.option_strings and not isinstance(a, argparse._HelpAction) for o in a.option_strings]
    valued_all = ['--remote', '--serial']
    arms = []
    for name in commands:
        parser = top.choices[name]
        sub = next((a for a in parser._actions if isinstance(a, argparse._SubParsersAction)), None)
        if sub is not None:                                              # radio: its actions are the first word
            arms.append((name, [], visible(sub), False, []))
            for action in visible(sub):
                o, c, t, v = spec(sub.choices[action])
                valued_all += v
                arms.append((f'{name} {action}', o, c, t, []))
            continue
        o, c, t, v = spec(parser)
        valued_all += v
        arms.append((name, o, c, t, []))
    out = [f'# bash completion for {APP}: source <({APP} completion), or {APP} completion --install',
           f'_{APP.replace("-", "_")}() {{',
           '    local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}',
           '    local i w cmd= sub= npos=0 key opts= choices= subs= target=0 n',
           '    COMPREPLY=()',
           '    case $prev in',
           '        --remote) return ;;',
           '        --serial) COMPREPLY=($(compgen -G "/dev/tty*" -- "$cur")); return ;;',
           '    esac',
           '    for ((i = 1; i < COMP_CWORD; i++)); do',
           '        w=${COMP_WORDS[i]}',
           '        case $w in',
           f'            {"|".join(sorted(set(valued_all)))}) ((i++)); continue ;;',
           '            -*) continue ;;',
           '        esac',
           '        if [[ -z $cmd ]]; then cmd=$w',
           '        elif [[ $cmd == radio && -z $sub ]]; then sub=$w',
           '        else ((npos++)); fi',
           '    done',
           '    key=$cmd${sub:+ $sub}',
           '    case "$key" in',
           f'        "") opts="{" ".join(glob_opts + ["-h", "--help"])}"; subs="{" ".join(commands)}" ;;']
    for key, o, c, t, _ in arms:
        sub_words = " ".join(c) if key == 'radio' else ''
        ch = '' if key == 'radio' else " ".join(c)
        out.append(f'        "{key}") opts="{" ".join(o)}"; choices="{ch}"; subs="{sub_words}"; target={1 if t else 0} ;;')
    out += ['        *) return ;;',
            '    esac',
            '    if [[ $cur == -* ]]; then',
            '        COMPREPLY=($(compgen -W "$opts" -- "$cur"))',
            '    elif [[ -n $subs && -z $cmd ]]; then',
            '        COMPREPLY=($(compgen -W "$subs" -- "$cur"))',
            '    elif [[ $cmd == radio && -z $sub ]]; then',
            '        COMPREPLY=($(compgen -W "$subs" -- "$cur"))',
            '    elif [[ $target == 1 && $npos -eq 0 ]]; then',
            "        local IFS=$'\\n'",
            '        for n in $(command "${COMP_WORDS[0]}" __names 2>/dev/null); do',
            '            [[ ${n,,} == "${cur,,}"* ]] && COMPREPLY+=("$(printf %q "$n")")',
            '        done',
            '    elif [[ -n $choices && $npos -eq 0 ]]; then',
            '        COMPREPLY=($(compgen -W "$choices" -- "$cur"))',
            '    fi',
            '}',
            f'complete -F _{APP.replace("-", "_")} {APP}', '']
    return '\n'.join(out)


def write_completion(ap: argparse.ArgumentParser) -> str | None:
    """Install the completion for this user; returns the path, or None when it could not be written."""
    try:
        os.makedirs(os.path.dirname(COMPLETION_FILE), exist_ok=True)
        with open(COMPLETION_FILE, 'w') as f:
            f.write(completion_script(ap))
        return COMPLETION_FILE
    except OSError:
        return None


def cmd_completion(opts, ap) -> int:
    if opts.install:
        path = write_completion(ap)
        if path is None:
            print(f'{APP}: could not write {COMPLETION_FILE}')
            return 1
        print(f'wrote {path} (bash-completion loads it in new shells; or: source {path})')
        return 0
    sys.stdout.write(completion_script(ap))
    return 0


def cmd_names() -> int:
    """Contact and channel names, one per line, for the tab completion. Only asks a radio daemon that is already
    running (completing a word must not start the radio)."""
    if REMOTE or not asyncio.run(daemon_reachable()):
        return 0

    async def names(_a):
        app = await cli_app()
        try:
            for _k, name, _c in cli_contacts(app):
                print(name)
            for _i, name in app.channels:
                print('#' + name.lstrip('#'))
        finally:
            await cli_finish(app)
        return 0
    return run_cli(names, None)


