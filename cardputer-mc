class ConnectionMixin:
    async def toggle_connection(self):
        if self.connecting:
            return
        if self.mc:
            await self.disconnect()
        else:
            self.connect_to()

    def start_auto_connect(self):
        self.connect_to()

    def connect_to(self):
        self.connecting = True
        self.status = f'connecting to {self.target()}...'
        self.dirty = True
        asyncio.create_task(self.connect())

    async def connect(self):
        mc = None
        try:
            self.status = 'starting radio...' if not REMOTE else f'connecting to {REMOTE}...'
            self.dirty = True
            await ensure_daemon()
            mc = MeshCore(TCPConnection(HOST, DAEMON_PORT))
            await mc.connect()
            if mc.self_info is None:
                raise RuntimeError('no response from radio')
            self.mc = mc
            mc.set_decrypt_channel_logs(True)    # RX log entries for channel packets then carry the message
            # announce protocol v3: the radio then reports SNR with each received message
            r = await mc.commands.send_device_query()
            log.info('device query: %s', 'ok' if r.type != EventType.ERROR else describe_error(r.payload))
            await self.load()
            await self.sync_radio_clock()
            await self.refresh_battery()
            mc.subscribe(EventType.CONTACT_MSG_RECV, self.on_contact_msg)
            mc.subscribe(EventType.CHANNEL_MSG_RECV, self.on_chan_msg)
            mc.subscribe(EventType.ACK, self.on_ack)
            mc.subscribe(EventType.RX_LOG_DATA, self.on_rx_log)
            for ev in (EventType.NEW_CONTACT, EventType.ADVERTISEMENT, EventType.PATH_UPDATE):
                mc.subscribe(ev, self.on_contacts_changed)
            await self.log_autoadd_config()
            mc.subscribe(EventType.DISCONNECTED, self.on_disconnected)
            await mc.start_auto_message_fetching()
            await self.drain_queue(mc)
            self.save_config()
            self.status = f'connected to {self.target()}'
            self.keepalive_task = asyncio.create_task(self.guarded(self.keepalive()))
        except BaseException as e:
            self.mc = None
            if mc is not None:
                try:
                    await mc.disconnect()
                except Exception:
                    pass
            if isinstance(e, asyncio.CancelledError):
                raise
            self.status = f'connect failed: {str(e) or type(e).__name__}'
        finally:
            self.connecting = False
            self.dirty = True

    async def keepalive(self):
        """Ask for the battery now and then: it keeps the title bar's battery fresh (the daemon looks after the radio link)."""
        tick = 0
        while self.mc is not None:
            await asyncio.sleep(NOISE_EVERY)
            if self.mc is not None:
                await self.sample_noise()
                tick += 1
                if tick % max(1, 45 // NOISE_EVERY) == 0:
                    await self.refresh_battery()

    async def sample_noise(self):
        """One reading of the radio's noise floor (dBm) for the /noise graph; radios that do not report it are left alone."""
        if self.noise_unsupported:
            return
        try:
            got = await read_noise(self)
        except Exception:
            got = None
        if got is None or got[0] is None:
            self.noise_misses += 1
            self.noise_unsupported = self.noise_misses >= 3 and not self.noise_hist
            return
        self.noise_hist.append(got[0])
        if self.noise_open:
            self.dirty = True

    async def disconnect(self, reason: str = 'disconnected'):
        task, self.keepalive_task = self.keepalive_task, None
        if task is not None and task is not asyncio.current_task():
            task.cancel()
        mc, self.mc = self.mc, None
        if mc is None:
            return
        self.contact_cache = dict(mc.contacts)
        self.pending_acks.clear()
        self.admin.clear()
        self.status = reason
        self.dirty = True
        try:
            await mc.disconnect()
        except Exception:
            pass

    async def on_disconnected(self, event):
        # device unplugged / link lost; skip our own manual disconnect
        if self.mc is not None:
            asyncio.create_task(self.guarded(self.connection_lost()))

    async def connection_lost(self):
        """The link broke without us asking (meshcore-pi died or dropped us): start again, a few times."""
        log.warning('connection lost; reconnecting')
        await self.disconnect('connection lost')
        if stop_requested():                  # `cardputer-mc stop` was run somewhere: leave the radio off
            self.status = 'the radio was stopped (cardputer-mc radio stop); F3 starts it again'
            self.dirty = True
            return
        for n, wait in enumerate((2, 5, 15, 30, 60), 1):
            self.status = f'connection lost; reconnecting in {wait}s ({n}/5)'
            self.dirty = True
            await asyncio.sleep(wait)
            if self.quit or self.mc is not None or self.connecting:
                return                            # quitting, or the user already reconnected
            self.connect_to()
            while self.connecting:
                await asyncio.sleep(0.5)
            if self.mc is not None:
                log.info('reconnected')
                return
        self.status = 'could not reconnect: press F3 to try again'
        self.dirty = True

    async def load_channels(self) -> int | None:
        """Refresh self.channels from the radio; returns the first free slot, if any."""
        chans, free = [], None
        for idx in range(MAX_CHANNELS):
            async with self.radio_lock:
                r = await self.mc.commands.get_channel(idx)
            if r.type == EventType.ERROR:
                break
            name = r.payload.get('channel_name', '')
            if name:
                chans.append((idx, name))
                sec = r.payload.get('channel_secret')
                if sec:
                    self.chan_secrets[idx] = sec.hex() if isinstance(sec, (bytes, bytearray)) else str(sec)
            elif free is None:
                free = idx
        self.channels = chans
        self.dirty = True
        return free

    async def create_channel(self, arg: str):
        """/channel <name> [secret-hex]: #name = public hashtag channel, otherwise private."""
        if not self.need_radio():
            return
        parts = arg.split()
        if not parts or len(parts) > 2:
            self.status = 'usage: /channel <name> [32-hex-char secret]'
            return
        name = parts[0]
        if len(name.encode()) > 31:
            self.status = 'channel name too long (max 31 bytes)'
            return
        secret = None
        if len(parts) == 2:
            try:
                secret = bytes.fromhex(parts[1])
            except ValueError:
                secret = b''
            if len(secret) != 16:
                self.status = 'secret must be 32 hex characters (16 bytes)'
                return
        elif not name.startswith('#'):
            secret = os.urandom(16)          # private channel: random key, share it by hand
        if any(n == name for _, n in self.channels):
            self.status = f'channel {name} already exists'
            return
        free = await self.load_channels()
        if free is None:
            self.status = 'no free channel slot on the radio'
            return
        async with self.radio_lock:
            r = await self.mc.commands.set_channel(free, name, secret)
        if r.type == EventType.ERROR:
            self.status = f'create channel failed: {describe_error(r.payload)}'
            return
        await self.load_channels()
        self.select(('c', free))
        if name.startswith('#'):
            self.note(f'joined public channel {name} (slot {free})')
        else:
            self.note(f'created channel {name} (slot {free}); secret: '
                      f'{secret.hex() if secret else "derived from name"}')
        self.status = f'channel {name} created'

    async def load(self):
        async with self.radio_lock:
            await self.mc.ensure_contacts()
        await self.load_channels()
        if self.selected is None and (e := self.entries()):
            self.select(e[0][0])
        self.dirty = True

    async def on_contacts_changed(self, event):
        # the library only marks its contact table dirty on adverts; fetch the new entries
        mc = self.mc
        if mc is not None:
            log.info('%s: %s', event.type.value, str(event.payload.get('public_key', ''))[:12])
            try:
                async with self.radio_lock:
                    await mc.ensure_contacts(follow=True)
            except Exception as e:
                log.warning('contact refresh failed: %s', e)
        self.dirty = True

    async def log_autoadd_config(self):
        try:
            r = await self.mc.commands.get_autoadd_config()
            log.info('autoadd config: %s', r.payload)
        except Exception as e:
            log.info('autoadd config unavailable: %s', e)

    async def drain_queue(self, mc):
        """Fetch everything the radio queued while we were away (the library fetches only one)."""
        n = 0
        for _ in range(200):
            async with self.radio_lock:
                r = await mc.commands.get_msg()
            if r.type in (EventType.NO_MORE_MSGS, EventType.ERROR):
                break
            n += 1
            await asyncio.sleep(0.05)
        if n:
            log.info('fetched %d queued message(s)', n)

    async def pick_device(self):
        if self.mc:
            await self.disconnect()
        self.connect_to()

    async def reload(self):
        if self.need_radio():
            self.status = 'reloading...'
            async with self.radio_lock:      # load_channels takes the lock itself, so only the contacts here
                await self.mc.commands.get_contacts()
            await self.load_channels()
            self.dirty = True
            self.status = f'connected to {self.target()}'

# ======================================================================
# messaging
# ======================================================================

class MessagingMixin:
    def rx_route(self, kind: str, text: str, sender_ts, src: str = '') -> dict:
        """How a message that just came in travelled: the radio log packet it arrived in (the message event itself carries
        no path for a direct route). A channel message is found by its text and time, a direct one as the latest
        packet from that sender. Returns {rx_route, rx_hops} or nothing when the packet is not known."""
        now = time.time()
        for t, p in reversed(self.rx_recent):
            if now - t > 60:
                break
            if kind == 'GRP_TXT':
                if p.get('payload_typename') != 'GRP_TXT' or p.get('message') != text or p.get('sender_timestamp') != sender_ts:
                    continue
            elif p.get('payload_typename') != 'TXT_MSG' or p.get('rx_used') or (src and (p.get('payload') or '')[2:4] != src[:2]):
                continue
            p['rx_used'] = True
            return {'rx_route': (p.get('route_typename') or '?').lower(), 'rx_hops': self.path_hops(p)}
        return {}

    def on_contact_msg(self, event):
        p = event.payload
        prefix = p.get('pubkey_prefix', '')[:12]
        c = self.mc.get_contact_by_key_prefix(prefix) if prefix else None
        who = c['adv_name'] if c else prefix[:8]
        info = dict(p)
        info.update(self.rx_route('TXT_MSG', p.get('text', ''), p.get('sender_timestamp'), prefix))
        self.add(('d', prefix), Msg(p.get('sender_timestamp', 0), who, p.get('text', ''),
                                    recv=int(datetime.now().timestamp()), info=info))

    def on_chan_msg(self, event):
        p = event.payload
        # channel text already arrives as "sender: message"
        key = ('c', p.get('channel_idx', 0))
        info = dict(p)
        info.update(self.rx_route('GRP_TXT', p.get('text', ''), p.get('sender_timestamp')))
        msg = Msg(p.get('sender_timestamp', 0), '', p.get('text', ''),
                  recv=int(datetime.now().timestamp()), info=info)
        if self.is_blocked(key, self.sender_of(msg)):
            return
        self.add(key, msg)

    def on_ack(self, event):
        m = self.pending_acks.pop(event.payload.get('code', ''), None)
        if m:
            m.status = 'acked'
            self.dirty = True

    async def send(self, text: str):
        key = self.selected
        if key in (RX_KEY, LOG_KEY):
            self.status = 'this view is read-only: pick a channel or contact to send'
            return
        if key is None or not text or not self.need_radio():
            return
        c = self.selected_contact()
        if c and c.get('type') == 2:                 # repeaters take commands, not chat
            await self.send_admin(text)
            return
        now = int(datetime.now().timestamp())
        msg = Msg(now, 'me', text, mine=True, recv=now)
        self.add(key, msg)
        await self.deliver(key, msg)

    async def transmit(self, key: tuple, msg: Msg, contact: dict | None, attempt: int = 0):
        """One send to the radio; retried when the radio rejects it (busy / queue full)."""
        async with self.radio_lock:
            for n in range(self.retries + 1):
                if key[0] == 'c':
                    r = await self.mc.commands.send_chan_msg(key[1], msg.text, msg.ts)
                else:
                    r = await self.mc.commands.send_msg(contact, msg.text, msg.ts, attempt)
                if r.type != EventType.ERROR:
                    break
                log.warning('send attempt %d to %s failed: %s %s', n + 1,
                            self.name_for(key), describe_error(r.payload), r.payload)
                if n < self.retries:
                    await asyncio.sleep(1)
        return r

    def expect_ack(self, msg: Msg, payload: dict):
        code = payload.get('expected_ack')
        if code:
            self.pending_acks[code if isinstance(code, str) else code.hex()] = msg

    async def deliver(self, key: tuple, msg: Msg):
        contact = None
        if key[0] == 'd':
            contact = self.mc.get_contact_by_key_prefix(key[1])
            if contact is None:
                msg.status = 'failed'
                self.status = 'unknown contact'
                self.dirty = True
                return
        r = await self.transmit(key, msg, contact)
        if r.type in (EventType.MSG_SENT, EventType.OK):      # channel sends are answered with a plain OK
            msg.status = 'sent'
            msg.info = dict(r.payload)
            if key[0] == 'c':
                name = (self.mc.self_info or {}).get('name', '')
                self.pending_repeats[(msg.ts, f'{name}: {msg.text}')] = (msg, time.time())
            if key[0] == 'd':
                self.expect_ack(msg, r.payload)
                if self.retries:
                    asyncio.create_task(self.guarded(self.watch_ack(key, msg)))
        else:
            msg.status = 'failed'
            self.status = f'send failed: {describe_error(r.payload)}'
        self.dirty = True

    async def watch_ack(self, key: tuple, msg: Msg):
        """Resend an unacknowledged direct message up to `retries` times, then mark it failed."""
        for attempt in range(self.retries + 1):
            wait = msg.info.get('suggested_timeout', 10000) / 1000 + 2
            for _ in range(int(wait * 2)):
                await asyncio.sleep(0.5)
                if msg.status != 'sent' or self.mc is None:
                    return
            if attempt == self.retries:
                break
            contact = self.mc.get_contact_by_key_prefix(key[1])
            if contact is None:
                break
            self.status = f'no ack from {contact.get("adv_name", "?")}, retry {attempt + 1}/{self.retries}'
            self.dirty = True
            r = await self.transmit(key, msg, contact, attempt + 1)
            if r.type == EventType.ERROR:
                break
            msg.info.update(r.payload)
            self.expect_ack(msg, r.payload)
        if msg.status == 'sent':
            msg.status = 'failed'
            self.status = 'no acknowledgement received'
            self.dirty = True

    def do_search(self, q: str):
        if not q:
            self.status = 'usage: /search <text>'
            return
        hits = []
        for key, msgs in self.history.items():
            if not key or key in (RX_KEY, LOG_KEY):
                continue
            for i, m in enumerate(msgs):
                if q.lower() in m.text.lower():
                    hits.append((m.recv or m.ts, key, i, m))
        hits.sort(key=lambda h: -h[0])
        if not hits:
            self.status = f'no messages match "{q}"'
            return
        self.search = {'q': q, 'hits': hits[:200], 'sel': 0, 'total': len(hits)}

    def handle_search_key(self, k):
        sr = self.search
        n = len(sr['hits'])
        if k in ('\x1b', 'q'):
            self.search = None
        elif k == curses.KEY_UP:
            sr['sel'] = max(0, sr['sel'] - 1)
        elif k == curses.KEY_DOWN:
            sr['sel'] = min(n - 1, sr['sel'] + 1)
        elif k == '\t':                                      # Tab: the next hit, round to the first
            sr['sel'] = (sr['sel'] + 1) % n
        elif k == curses.KEY_PPAGE:
            sr['sel'] = max(0, sr['sel'] - 10)
        elif k == curses.KEY_NPAGE:
            sr['sel'] = min(n - 1, sr['sel'] + 10)
        elif k == curses.KEY_HOME:
            sr['sel'] = 0
        elif k == curses.KEY_END:
            sr['sel'] = n - 1
        elif k == '\n':
            _, key, i, _m = sr['hits'][sr['sel']]
            self.search = None
            self.select(key)
            self.focus, self.msg_sel = 'msgs', i
        elif isinstance(k, str) and len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C):
            self.quit = True
        self.dirty = True

    def draw_search(self, scr, h, w):
        sr = self.search
        bw = min(w - 2, 78)
        bh = min(h - 2, len(sr['hits']) + 3)
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for y in range(bh):
            scr.addstr(y0 + y, x0, blank(bw), theme_REV)
        shown = len(sr['hits'])
        more = f' (first {shown} of {sr["total"]})' if sr['total'] > shown else ''
        scr.addnstr(y0, x0 + 1, f'Search "{sr["q"]}": {sr["total"]} match(es){more}', bw - 2, theme_REV | curses.A_BOLD)
        rows = bh - 3
        top = max(0, min(sr['sel'] - rows // 2, shown - rows))
        for i, (_, key, _idx, m) in enumerate(sr['hits'][top:top + rows]):
            who = f'{self.name_for(key)}: ' if key else ''
            line = f'{hhmm(m.recv or m.ts)} {who}{m.who + ": " if m.who and m.who != "me" else ""}{m.text}'
            attr = theme_SEL if top + i == sr['sel'] else theme_REV
            scr.addnstr(y0 + 1 + i, x0 + 1, pad(line.replace('\n', ' '), bw - 2), bw - 2, attr)
        scr.addnstr(y0 + bh - 1, x0 + 1, 'Enter jump to message · Esc close', bw - 2, theme_REV | curses.A_DIM)
        curses.curs_set(0)

    def message_details(self, m: Msg) -> list[str]:
        key = self.selected
        info = m.info
        fmt = lambda t: datetime.fromtimestamp(t).strftime('%Y-%m-%d %H:%M:%S') if t else '-'
        rows: list[tuple[str, str]] = []
        me = (self.mc.self_info or {}).get('name', 'me') if self.mc else 'me'
        text = m.text
        if key and key[0] == 'c':
            chan = self.name_for(key)
            if m.mine:
                rows += [('From', f'{me} (you)'), ('To', f'channel {chan}')]
            else:
                sender, sep, rest = text.partition(': ')
                if sep:
                    rows.append(('From', sender))
                    text = rest
                rows.append(('Channel', f'{chan} (slot {key[1]})'))
        elif key:
            c = next((v for k2, v in self.contacts().items() if k2.startswith(key[1])), None)
            peer = self.name_for(key)
            if m.mine:
                rows += [('From', f'{me} (you)'), ('To', peer)]
            else:
                rows.append(('From', peer))
            rows.append(('Key', c['public_key'] if c else key[1]))
            if c:
                rows.append(('Node type', NODE_TYPES.get(c.get('type'), '?')))
        if m.mine:
            rows.append(('Sent', fmt(m.ts)))
            if m.info.get('heard'):
                rows.append(('Repeats heard', f'{len(m.info["heard"])}  (' + ', '.join(m.info['heard']) + ')'))
            rows.append(('Status', {'sent': 'sent to radio (no ack yet)',
                                    'acked': 'delivered (ack received)',
                                    'failed': 'failed (press r in the message list to resend)'}.get(m.status, m.status or '-')))
        elif m.info:
            rows.append(('Sent (sender clock)', fmt(info.get('sender_timestamp', 0))))
            rows.append(('Received', fmt(m.recv)))
            plen = info.get('path_len')
            hops = info.get('rx_hops')
            if info.get('rx_route'):
                rows.append(('Route', info['rx_route'] + (f', {len(hops)} hop(s): ' + ' > '.join(hops) if hops else
                                                           ', no repeater in the path' if info['rx_route'] == 'flood' else
                                                           ' (the path is used up on arrival: it does not say which repeaters)')))
            elif plen is not None:
                rows.append(('Route', 'direct' if plen == 255 else f'{plen} hop(s)'))
            for label, k, unit in (('SNR', 'SNR', ' dB'), ('RSSI', 'RSSI', ' dBm')):
                if k in info:
                    rows.append((label, f'{info[k]}{unit}'))
            if info.get('path'):
                rows.append(('Path', info['path']))
            if 'txt_type' in info:
                rows.append(('Text type', {0: 'plain', 1: 'command', 2: 'signed'}.get(
                    info['txt_type'], str(info['txt_type']))))
        else:
            rows.append(('Note', 'local message (not from the radio)'))
        out = [f'{a + ":":<22}{b}' for a, b in rows]
        out += ['', 'Message:']
        out += textwrap.wrap(text, 64) or ['']
        return out

    def handle_msg_focus_key(self, k) -> bool:
        """Keys while the message list has focus; returns False to fall through to the input."""
        msgs = self.history.get(self.selected, [])
        page = max(1, self.last_body_h // 2)
        if k == '\t':
            self.fsel = 0
            self.focus = 'fkeys'
        elif k == curses.KEY_LEFT:
            self.focus = 'side'
        elif k == curses.KEY_RIGHT:
            pass
        elif k == '\x1b':                    # Esc is Tab backwards: to the list
            self.focus = 'side'
        elif k == curses.KEY_UP:
            self.msg_sel = max(0, self.msg_sel - 1)
        elif k == curses.KEY_DOWN:
            self.msg_sel = min(len(msgs) - 1, self.msg_sel + 1)
        elif k == curses.KEY_PPAGE:
            self.msg_sel = max(0, self.msg_sel - page)
        elif k == curses.KEY_NPAGE:
            self.msg_sel = min(len(msgs) - 1, self.msg_sel + page)
        elif k == curses.KEY_HOME:
            self.msg_sel = 0
        elif k == curses.KEY_END:
            self.msg_sel = len(msgs) - 1
        elif k in ('r', 'R') and msgs and msgs[self.msg_sel].mine and \
                msgs[self.msg_sel].status == 'failed' and self.selected not in (RX_KEY, LOG_KEY):
            if self.need_radio():
                m = msgs[self.msg_sel]
                m.status = ''
                self.status = 'resending...'
                asyncio.create_task(self.guarded(self.deliver(self.selected, m)))
        elif k == '\n' and msgs:
            if self.selected == RX_KEY:
                self.show_packet(msgs[self.msg_sel].info)
            elif self.selected == LOG_KEY:
                m = msgs[self.msg_sel]
                self.show('Log entry', [f'Time: {datetime.fromtimestamp(m.ts):%Y-%m-%d %H:%M:%S}', ''] +
                          (textwrap.wrap(m.text, 64) or ['']))
            else:
                self.show('Message details', self.message_details(msgs[self.msg_sel]))
        elif k in ('/', ':', ' '):
            self.start_typing(k)
        elif isinstance(k, str) and (k.isprintable() or k == '\x7f'):
            pass                          # other letters do not start a message; Enter, Space, / or : do
        else:
            return False
        self.dirty = True
        return True

    def draw_details(self, scr, h, w):
        room = h - 4
        self.details_scroll = max(0, min(self.details_scroll, len(self.details) - room))
        rows = self.details[self.details_scroll:self.details_scroll + room]
        more = len(self.details) > room
        bw = min(w - 2, 78)
        bh = len(rows) + 3
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for y in range(bh):
            scr.addstr(y0 + y, x0, blank(bw), theme_REV)
        scr.addnstr(y0, x0 + 1, self.details_title, bw - 2, theme_REV | curses.A_BOLD)
        verdicts = self.details_title.startswith(('Trace', 'Ping', 'Route'))
        hmax = max(0, max((len(l) for l in self.details), default=0) - (bw - 2))
        self.details_hscroll = min(self.details_hscroll, hmax)
        hs = self.details_hscroll
        for i, line in enumerate(rows):
            scr.addnstr(y0 + 1 + i, x0 + 1, line[hs:], bw - 2,
                        theme_result_attr(line, theme_REV) if verdicts else theme_REV)
        horiz = hmax > 0
        scr.addnstr(y0 + bh - 1, x0 + 1,
                    (f'{"↑↓" if more else ""}{"←→" if horiz else ""} scroll · other key closes' if more or horiz
                     else 'press any key to close')
                    + (' (back to the menu)' if self.details_back else ''), bw - 2,
                    theme_REV | curses.A_DIM)
        curses.curs_set(0)

    def show_packet(self, p: dict):
        """Details window for one RX log packet."""
        ts = p.get('recv_time')
        path, size = p.get('path', ''), p.get('path_hash_size', 1) or 1
        rows = [('Time', datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M:%S') if ts else '-'),
                ('Type', p.get('payload_typename', '?')),
                ('Route type', p.get('route_typename', '?')),
                ('RSSI', f'{p["rssi"]} dBm' if 'rssi' in p else '-'),
                ('SNR', f'{p["snr"]} dB' if 'snr' in p else '-'),
                ('Length', f'{p.get("payload_length", "-")} bytes')]
        n = p.get('path_len', 0)
        if p.get('payload_typename') == 'TRACE':
            rows.append(('Hop SNRs', ' > '.join(f'{(int(path[i:i + 2], 16) - (256 if int(path[i:i + 2], 16) > 127 else 0)) / 4:.2f}'
                                                for i in range(0, len(path), 2)) or '-'))
        else:
            hops = [path[i:i + size * 2] for i in range(0, len(path), size * 2)]
            rows.append(('Path', (f'{n} hop(s): ' + ' > '.join(self.hop_name(h) for h in hops)) if hops
                         else 'direct' if n == 0 else f'{n} hop(s)'))
        if p.get('transport_code'):
            rows.append(('Transport code', p['transport_code']))
        if 'pkt_hash' in p:
            rows.append(('Packet hash', str(p['pkt_hash'])))
        if p.get('payload_typename') == 'ADVERT':
            key = p.get('adv_key', '')
            c = next((v for v in self.contacts().values() if key and v['public_key'] == key), None)
            rows += [('Advert from', p.get('adv_name') or (c or {}).get('adv_name') or '?'),
                     ('Public key', key),
                     ('Node type', NODE_TYPES.get(p.get('adv_type'), str(p.get('adv_type', '?'))))]
            if p.get('adv_timestamp'):
                rows.append(('Advert time', datetime.fromtimestamp(p['adv_timestamp']).strftime('%Y-%m-%d %H:%M:%S')))
            if p.get('adv_lat') or p.get('adv_lon'):
                rows.append(('Position', f'{p.get("adv_lat", 0):.5f}, {p.get("adv_lon", 0):.5f}'))
                if dist := self.distance_text(p.get('adv_lat', 0), p.get('adv_lon', 0)):
                    rows.append(('Distance', dist))
        for k, label in (('chan_name', 'Channel'), ('message', 'Message'), ('sender_timestamp', 'Sender time'),
                         ('attempt', 'Attempt'), ('chan_hash', 'Channel hash'), ('cipher_mac', 'MAC')):
            if k in p:
                rows.append((label, str(p[k])))
        if p.get('payload'):
            rows.append(('Raw', p['payload']))
        out = []
        for a, b in rows:
            lines = textwrap.wrap(str(b), 52, break_long_words=True) or ['']
            out.append(f'{a + ":":<16}{lines[0]}')
            out += [' ' * 16 + l for l in lines[1:]]
        self.show('Packet', out)

    def count_repeat(self, p: dict):
        """A channel packet that matches one of our recent sends is a repeater re-broadcasting it."""
        now = time.time()
        for k in [k for k, (_, t) in self.pending_repeats.items() if now - t > 300]:
            del self.pending_repeats[k]
        hit = self.pending_repeats.get((p.get('sender_timestamp'), p.get('message')))
        if hit is None:
            return
        heard = hit[0].info.setdefault('heard', [])
        route = ' > '.join(self.path_hops(p)) or 'direct'
        if route not in heard:                # the same path twice is one repeater heard twice
            heard.append(route)
            self.dirty = True

    def path_hops(self, p: dict) -> list[str]:
        path, step = p.get('path') or '', 2 * (p.get('path_hash_size') or 1)
        return [self.hop_name(path[i:i + step]) for i in range(0, len(path), step)]

    def on_rx_log(self, event):
        p = event.payload
        ptype = p.get('payload_typename', '?')
        path = p.get('path', '')
        hops = []
        if ptype == 'TRACE':        # path bytes are per-hop SNR, quarter-dB steps
            hops = [f'{(int(path[i:i + 2], 16) - (256 if int(path[i:i + 2], 16) > 127 else 0)) / 4:.2f}dB'
                    for i in range(0, len(path), 2)]
        elif ptype != 'ACK':
            hops = self.path_hops(p)
        extra = ''
        if ptype == 'ADVERT' and p.get('adv_key'):
            self.signal[p['adv_key'][:12]] = (int(datetime.now().timestamp()), p.get('snr'),
                                              p.get('rssi'), 'advert')
        if ptype == 'ADVERT':
            key = p.get('adv_key', '')
            c = self.mc.get_contact_by_key_prefix(key[:8]) if self.mc and key else None
            extra = f'  from {p.get("adv_name") or (c or {}).get("adv_name") or key[:8] or "?"}'
        elif ptype == 'ACK':
            extra = f'  ack {path}'
        if hops:
            extra += '  path ' + ' > '.join(hops)
        if ptype in ('GRP_TXT', 'TXT_MSG'):
            self.rx_recent.append((time.time(), dict(p)))
        if ptype == 'GRP_TXT' and p.get('message') is not None:
            self.count_repeat(p)
        now = int(datetime.now().timestamp())
        self.add(RX_KEY, Msg(now, '', f'{ptype:<9} rssi {p.get("rssi", "?"):>4} '
                             f'snr {p.get("snr", "?"):>5}{extra}', recv=now, info=dict(p)), unread=False)

    def render_lines(self, width: int) -> list[tuple[str, int, int]]:
        lines = []
        for n, m in enumerate(self.history.get(self.selected, [])):
            mark = {'sent': ' ·', 'acked': ' ✓', 'failed': ' ✗'}.get(m.status, '')
            if m.mine and m.info.get('heard'):
                mark = ' ✓'                   # heard back from at least one repeater; Enter shows how many
            body = f'{m.who}: {m.text}' if m.who else m.text
            prefix = f'{hhmm(m.ts)} ' if width >= TIME_MIN_WIDTH else ''
            attr = (theme_NOTE if m.who == '*' else theme_FAIL if m.status == 'failed'
                    else theme_ME if m.mine else curses.A_NORMAL)
            wrapped = textwrap.wrap(body + mark, max(10, width - len(prefix)),
                                    subsequent_indent='  ') or ['']
            for i, w in enumerate(wrapped):
                lines.append(((prefix if i == 0 else ' ' * len(prefix)) + w, attr, n))
        return lines


