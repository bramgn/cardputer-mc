@dataclass
class Msg:
    ts: int
    who: str
    text: str
    mine: bool = False
    status: str = ''   # '' | 'sent' | 'acked' | 'failed'
    recv: int = 0                          # local time we saw it
    info: dict = field(default_factory=dict)   # raw radio fields for the details view


def hhmm(ts: int) -> str:
    return datetime.fromtimestamp(ts or datetime.now().timestamp()).strftime('%H:%M')


STATUS_RANK = {'': 0, 'failed': 1, 'sent': 2, 'acked': 3}


def merge_msgs(mine: list, other: list, since: float = 0) -> list:
    """Union of two copies of one conversation (this window's and the shared file's). Messages are the same when
    time, sender and text are. Our own object is kept (acks and retries hold on to it) and takes over the better
    status and the repeats the other copy has heard. Messages up to `since` were cleared and are dropped."""
    by_id = {}
    for m in mine:
        if (m.recv or m.ts) > since or m.who == '*':
            by_id[(m.ts, m.who, m.text)] = m
    for o in other:
        if (o.recv or o.ts) <= since:
            continue
        m = by_id.get((o.ts, o.who, o.text))
        if m is None:
            by_id[(o.ts, o.who, o.text)] = o
            continue
        if STATUS_RANK.get(o.status, 0) > STATUS_RANK.get(m.status, 0):
            m.status = o.status
        heard = list(m.info.get('heard', ()))
        heard += [h for h in o.info.get('heard', ()) if h not in heard]
        if heard:
            m.info['heard'] = heard
    return sorted(by_id.values(), key=lambda m: (m.recv or m.ts, m.ts))


def read_history_file() -> tuple:
    """(conversations, clear marks) from the history file that every window shares."""
    try:
        with open(HISTORY_FILE) as f:
            raw = json.load(f)
        cleared = raw.pop('__cleared__', {})
        return ({(k[0], k[1]): [Msg(**m) for m in ms] for k, ms in
                 ((json.loads(k), v) for k, v in raw.items())}, cleared if isinstance(cleared, dict) else {})
    except (OSError, ValueError, TypeError, IndexError, AttributeError):
        return {}, {}


