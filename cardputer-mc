def main():
    ap = build_parser()
    opts = ap.parse_args()
    command = opts.command
    if command == 'radio':                                             # `radio ACTION`; `radio` alone shows the status
        command = opts.command = opts.radio_command or 'status'
        if command in ('keep', 'sound') and not hasattr(opts, 'mode'):
            opts.mode = None
        if command == 'up' and not hasattr(opts, 'keep'):
            opts.keep = False
    if opts.serial:
        global SERIAL
        if opts.remote:
            sys.exit(f'{APP}: --serial and --remote cannot be combined (run {APP} --serial on the machine the radio is plugged into)')
        if command == 'check':
            sys.exit(f'{APP}: check tests the Cap-LoRa wiring, not a USB companion')
        SERIAL = opts.serial
        os.environ['CARDPUTER_MC_SERIAL'] = SERIAL         # the daemon, started detached, inherits it
    if opts.remote and command in ('check', 'daemon', 'up', 'stop', 'status', 'keep', 'sound', 'update'):
        full = command if command == 'update' else f'radio {command}'
        sys.exit(f'{APP}: {full} works on the machine that has the radio; use: ssh {opts.remote} {APP} {full}')
    if opts.remote:
        try:
            open_tunnel(opts.remote)
        except RuntimeError as e:
            sys.exit(f'{APP}: {e}')
    if command == 'sound':
        if opts.mode == 'test':
            err = play_chime_now('private')
            sys.exit(f'{APP}: {err}' if err else 0)
        if opts.mode:
            set_setting('sound', opts.mode)
        print(f'sound: {sound_mode()}')
        sys.exit(0)
    if command in ('up', 'keep'):
        if command == 'keep' and opts.mode is None:
            print(f'keep running when closed: {"on" if _keep_daemon() else "off"}')
            sys.exit(0)
        keep = opts.keep if command == 'up' else opts.mode == 'on'
        if command == 'keep' or opts.keep:
            set_setting('keep_daemon', keep)
        if command == 'keep' and not keep:
            print('keep running when closed: off (the daemon stops a minute after the last window)')
            sys.exit(0)
        try:
            asyncio.run(ensure_daemon())
        except RuntimeError as e:
            sys.exit(f'{APP}: {e}')
        print('radio daemon: running' + (', and it stays running when no window is open' if _keep_daemon() else ''))
        sys.exit(0)
    if command in ('send', 'read', 'contacts', 'channels', 'info', 'advert', 'listen', 'addcontact', 'ping', 'noise'):
        sys.exit(run_cli(globals()['cmd_' + command], opts))
    if command == 'update':
        sys.exit(cmd_update(opts))
    if command == 'completion':
        sys.exit(cmd_completion(opts, build_parser()))
    if command == '__names':
        sys.exit(cmd_names())
    if command == 'check':
        sys.exit(check())
    if command == 'stop':
        sys.exit(stop_daemon())
    if command == 'status':
        sys.exit(daemon_status())
    if command == 'daemon':
        logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s', datefmt='%H:%M:%S')
        up = os.environ.get('CARDPUTER_MC_UPSTREAM')      # host:port of a companion to use instead of meshcore-pi (tests)
        sys.exit(asyncio.run(Daemon((up.split(':')[0], int(up.split(':')[1])) if up else None).run()))
    terminfo_without_ech_rep()
    args = argparse.Namespace()
    locale.setlocale(locale.LC_ALL, '')
    os.environ.setdefault('ESCDELAY', '25')   # ncurses waits 1000ms after Esc by default
    # keep library log output off the screen; the Log entry shows it
    root = logging.getLogger()
    root.handlers[:] = [LOG]
    root.setLevel(logging.INFO)

    def wrapped(scr):
        asyncio.run(run(scr, args))

    try:
        curses.wrapper(lambda scr: (curses.raw(), wrapped(scr)))
    except KeyboardInterrupt:
        pass
    except Exception as e:
        raise SystemExit(f'{APP}: {type(e).__name__}: {e}')
    finally:
        if sys.stdout.isatty():                  # leave a clean screen, also on terminals without an alternate screen
            sys.stdout.write('\x1b[2J\x1b[3J\x1b[H')
            sys.stdout.flush()


if __name__ == '__main__':
    main()
