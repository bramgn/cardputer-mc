def cardputer_keyboard() -> bool:
    """True when we run in the CardputerZero's own terminal (its small screen and five keys under it), False in an ssh
    session, on a PC, or anywhere else. CARDPUTER_MC_KEYBOARD=1 or 0 overrides the guess."""
    forced = os.environ.get('CARDPUTER_MC_KEYBOARD', '').strip().lower()
    if forced in ('1', 'yes', 'on', 'true'):
        return True
    if forced in ('0', 'no', 'off', 'false'):
        return False
    return os.path.exists(LED_5V) and not (os.environ.get('SSH_CONNECTION') or os.environ.get('SSH_TTY'))

