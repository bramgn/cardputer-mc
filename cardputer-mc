class UiMixin:
    # The CardputerZero keeps its arrow keys on the Fn layer. Where letters are not text, z c f x steer instead.
    # Vim's h j k l, G (end) and Ctrl-D / Ctrl-U (half page) work the same way, and gg (home) takes two presses.
    NAV_LETTERS = {'z': curses.KEY_LEFT, 'c': curses.KEY_RIGHT, 'f': curses.KEY_UP, 'x': curses.KEY_DOWN,
                   'h': curses.KEY_LEFT, 'l': curses.KEY_RIGHT, 'k': curses.KEY_UP, 'j': curses.KEY_DOWN,
                   'G': curses.KEY_END, '\x04': curses.KEY_NPAGE, '\x15': curses.KEY_PPAGE}

    @staticmethod
    def is_last_window() -> bool:
        """True when this window is the only one on the local radio daemon (then quitting can switch the radio off)."""
        if REMOTE or daemon_pid() is None:
            return False
        try:
            with open(STATUS_FILE) as f:
                st = json.load(f)
            return st.get('windows', 1) <= 1 or time.time() - st.get('written', 0) > 30
        except (OSError, ValueError):
            return True

    def letters_are_text(self) -> bool:
        """True while typed letters are text: a question being answered, a setting being edited, the prompt."""
        if self.ask or (self.settings_open and self.set_edit is not None):
            return True
        modal = (self.details is not None or self.help_open or self.noise_open or self.confirm_quit or self.confirm_stop or self.confirm_remove
                 or self.settings_open or self.cmenu_open or self.advert_menu_open or self.search)
        return self.focus == 'input' and not modal

    # Ctrl-C and Alt-X / Alt-Q (ESC + key) ask whether to quit; F10 does too. Ctrl-Q quits at once.
    QUIT_KEYS = ('\x03', '\x1bx', '\x1bX', '\x1bq', '\x1bQ')

    async def handle_key(self, k):
        if k == '\x0c':                       # Ctrl-L: full repaint
            self.repaint = True
            self.dirty = True
            return
        if self.confirm_quit:                 # the quit question beats everything else, windows included
            if k in ('y', 'Y', '\n') or k in self.QUIT_KEYS:      # the shortcut again counts as yes
                if self.is_last_window():
                    self.confirm_quit, self.confirm_stop = False, True      # and then: leave the radio on?
                else:
                    self.quit = True
            elif k in ('n', 'N', '\x1b', curses.KEY_F10, curses.KEY_F8):
                self.confirm_quit = False
            self.dirty = True
            return
        if self.confirm_stop:
            if k in ('y', 'Y', '\n'):             # keep it running: it keeps listening, the next window picks it up
                self.keep_daemon = True
                self.quit = True
            elif k in ('n', 'N'):                 # switch the radio off too
                self.keep_daemon = False
                self.stop_daemon_on_quit = True
                self.quit = True
            elif k == '\x1b':                     # Esc: not quitting after all
                self.confirm_stop = False
            self.dirty = True
            return
        if k in self.QUIT_KEYS:
            self.confirm_quit = True
            self.dirty = True
            return
        if isinstance(k, str) and len(k) == 2 and k[0] == '\x1b':
            return                            # any other Alt combination does nothing
        if isinstance(k, str) and not self.confirm_quit and not self.confirm_stop and not self.confirm_remove and not self.letters_are_text():
            if k == 'g':
                if not self.pending_g:
                    self.pending_g = True             # first g: wait for the second
                    return
                self.pending_g, k = False, curses.KEY_HOME
            else:
                self.pending_g = False
                k = self.NAV_LETTERS.get(k, k)
        else:
            self.pending_g = False
        if self.details is not None:
            self.dirty = True
            page = max(1, self.scr_h - 5)
            if k == '\t':                                          # Tab: the next page; after the last one, back to the top
                last = max(0, len(self.details) - page)
                self.details_scroll = 0 if self.details_scroll >= last else self.details_scroll + page
                return
            if k in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE, curses.KEY_NPAGE,
                     curses.KEY_HOME, curses.KEY_END):
                self.details_scroll = {curses.KEY_UP: self.details_scroll - 1,
                                       curses.KEY_DOWN: self.details_scroll + 1,
                                       curses.KEY_PPAGE: self.details_scroll - page,
                                       curses.KEY_NPAGE: self.details_scroll + page,
                                       curses.KEY_HOME: 0, curses.KEY_END: 10 ** 6}[k]
                return
            if k in (curses.KEY_LEFT, curses.KEY_RIGHT):
                self.details_hscroll = max(0, self.details_hscroll + (8 if k == curses.KEY_RIGHT else -8))
                return
            self.details_hscroll = 0
            self.details = None
            back, self.details_back = self.details_back, None
            if back == 'options':                        # one step back: Options, or the Actions menu the window came from
                self.settings_open = True
            elif back and self.selected == back[0]:
                self.cmenu_open, self.cmenu_sel = True, back[1]
            return
        if self.noise_open:
            self.noise_open = False
            self.dirty = True
            return
        if self.help_open:
            if k == curses.KEY_UP:
                self.help_scroll = max(0, self.help_scroll - 1)
            elif k == curses.KEY_DOWN:
                self.help_scroll += 1
            elif k == curses.KEY_PPAGE:
                self.help_scroll = max(0, self.help_scroll - 10)
            elif k == curses.KEY_NPAGE:
                self.help_scroll += 10
            elif k == '\t':                                  # Tab: the next page; at the end, back to the top
                self.help_scroll = 0 if self.help_scroll >= max(0, len(self.HELP) - max(3, self.scr_h - 4)) else self.help_scroll + 10
            elif k == curses.KEY_HOME:
                self.help_scroll = 0
            elif k == curses.KEY_END:
                self.help_scroll = 10 ** 6
            elif k == curses.KEY_LEFT:
                self.help_hscroll = max(0, self.help_hscroll - 8)
            elif k == curses.KEY_RIGHT:
                self.help_hscroll += 8
            else:
                self.help_open = False
                self.help_hscroll = 0
            self.dirty = True
            return
        if self.ask:
            await self.handle_ask_key(k)
            return
        if self.confirm_remove:
            if k in ('y', 'Y'):
                run, self.confirm_remove = self.confirm_remove['run'], None
                await run()
            elif k in ('n', 'N', '\x1b', '\n'):
                back = self.confirm_remove.get('back')
                self.confirm_remove = None
                if k != '\n':
                    self.restore(back)
            self.dirty = True
            return
        if self.search:
            self.handle_search_key(k)
            return
        if self.cmenu_open:
            await self.handle_cmenu_key(k)
            return
        if self.advert_menu_open:
            await self.handle_advert_key(k)
            return
        if (cardputer_keyboard() and isinstance(k, str) and k in ('4', '5', '6', '7', '8') and self.focus != 'input' and not self.settings_open
                and not self.buf):                               # the keys under the screen, without Fn, when not typing
            k = (curses.KEY_F4, curses.KEY_F5, curses.KEY_F6, curses.KEY_F7, curses.KEY_F8)[int(k) - 4]
        if k in (curses.KEY_F8, curses.KEY_F10):                  # Quit
            self.confirm_quit = True
            self.dirty = True
            return
        if k == curses.KEY_F6 and not self.settings_open:         # Act(ions)
            self.open_contact_menu()
            self.dirty = True
            return
        if k in (curses.KEY_F4, curses.KEY_F1):                   # Help
            self.help_open, self.help_scroll = True, 0
            self.dirty = True
            return
        if k == curses.KEY_F7 and not self.settings_open:         # Advert (Log: the list on the left, or /log)
            self.advert_back = None
            await self.advert()
            self.dirty = True
            return
        if k == curses.KEY_F9:                                    # Radio (RX log)
            self.select(RX_KEY)
            return
        if k in (curses.KEY_F5, curses.KEY_F2) and not self.settings_open:   # Opts
            self.settings_open = True
            self.dirty = True
            return
        if self.settings_open:
            await self.handle_settings_key(k)
            return
        if self.focus == 'fkeys' and await self.handle_fkeys_key(k):
            return
        if self.focus == 'side' and self.handle_side_key(k):
            return
        if self.focus == 'msgs' and self.handle_msg_focus_key(k):
            return
        if k not in (curses.KEY_UP, curses.KEY_DOWN):
            self.hist_i = None                # typing or editing ends the walk through the history
        if isinstance(k, str):
            o = ord(k) if len(k) == 1 else -1
            if k == '\n':
                text, self.buf, self.pos = self.buf.strip(), '', 0
                self.remember_input(text)
                await self.submit(text)
            elif o in (CTRL_Q, CTRL_C):
                self.quit = True
            elif k == '\t':
                if self.buf.startswith(('/', ':')) and ' ' not in self.buf:
                    self.complete()
                elif self.history.get(self.selected):
                    self.focus = 'msgs'
                    self.msg_sel = len(self.history[self.selected]) - 1
                else:
                    self.focus = 'side'
            elif k == '\x1b':
                self.focus_back()
            elif k in ('\x7f', '\b'):
                if self.pos:
                    self.buf = self.buf[:self.pos - 1] + self.buf[self.pos:]
                    self.pos -= 1
                elif not self.buf and self.focus == 'input':      # nothing left to delete: leave the input
                    self.focus_back()
            elif o == 1:                       # ^A  home
                self.pos = 0
            elif o == 5:                       # ^E  end
                self.pos = len(self.buf)
            elif o == 2:                       # ^B  back
                self.pos = max(0, self.pos - 1)
            elif o == 6:                       # ^F  forward
                self.pos = min(len(self.buf), self.pos + 1)
            elif o == 4:                       # ^D  delete char
                self.buf = self.buf[:self.pos] + self.buf[self.pos + 1:]
            elif o == 21:                      # ^U  kill to start of line
                self.kill, self.buf, self.pos = self.buf[:self.pos], self.buf[self.pos:], 0
            elif o == 11:                      # ^K  kill to end of line
                self.kill, self.buf = self.buf[self.pos:], self.buf[:self.pos]
            elif o == 23:                      # ^W  kill previous word
                start = len(self.buf[:self.pos].rstrip())
                start = self.buf.rfind(' ', 0, start) + 1
                self.kill, self.buf, self.pos = (self.buf[start:self.pos],
                                                 self.buf[:start] + self.buf[self.pos:], start)
            elif o == 25:                      # ^Y  yank
                self.buf = self.buf[:self.pos] + self.kill + self.buf[self.pos:]
                self.pos += len(self.kill)
            elif o == 16:                      # ^P  previous conversation
                self.move(-1, False)
            elif o == 14:                      # ^N  next conversation
                self.move(1, False)
            elif k.isprintable():
                self.buf = self.buf[:self.pos] + k + self.buf[self.pos:]
                self.pos += 1
        elif k == curses.KEY_UP:               # earlier text or command you sent (^P / ^N switch conversation)
            self.recall(-1)
        elif k == curses.KEY_DOWN:
            self.recall(1)
        elif k == curses.KEY_PPAGE:
            self.scroll += 5
        elif k == curses.KEY_NPAGE:
            self.scroll = max(0, self.scroll - 5)
        elif k == curses.KEY_LEFT:
            self.pos = max(0, self.pos - 1)
        elif k == curses.KEY_RIGHT:
            self.pos = min(len(self.buf), self.pos + 1)
        elif k == curses.KEY_HOME:
            self.pos = 0
        elif k == curses.KEY_END:
            self.pos = len(self.buf)
        elif k == curses.KEY_BACKSPACE:
            if self.pos:
                self.buf = self.buf[:self.pos - 1] + self.buf[self.pos:]
                self.pos -= 1
            elif not self.buf and self.focus == 'input':          # nothing left to delete: leave the input
                self.focus_back()
        elif k == curses.KEY_DC:
            self.buf = self.buf[:self.pos] + self.buf[self.pos + 1:]
        elif k == curses.KEY_F3:
            await self.toggle_connection()
        self.dirty = True

    @staticmethod
    def load_input_history() -> list:
        try:
            with open(INPUT_HISTORY_FILE) as f:
                data = json.load(f)
            return [t for t in data if isinstance(t, str)][-INPUT_HISTORY_KEEP:]
        except (OSError, ValueError, TypeError):
            return []

    def remember_input(self, text: str):
        """Keep what was sent from the prompt (messages and commands) so Up can bring it back."""
        self.hist_i = None
        if not text:
            return
        # another window may have added lines meanwhile: fold them in, then add ours (no repeat of the last line)
        merged = self.load_input_history()
        if not merged or merged[-1] != text:
            merged.append(text)
        self.input_hist = merged[-INPUT_HISTORY_KEEP:]
        try:
            os.makedirs(os.path.dirname(INPUT_HISTORY_FILE), exist_ok=True)
            with open(INPUT_HISTORY_FILE + '.tmp', 'w') as f:
                json.dump(self.input_hist, f)
            os.replace(INPUT_HISTORY_FILE + '.tmp', INPUT_HISTORY_FILE)
        except OSError as e:
            log.warning('could not save the input history: %s', e)

    def recall(self, step: int):
        """Up (-1) / Down (+1) in the prompt: through earlier input; past the newest, back to what was being typed."""
        hist = self.input_hist
        if not hist:
            return
        if self.hist_i is None:
            if step > 0:
                return
            self.hist_draft, self.hist_i = self.buf, len(hist)
        i = max(0, self.hist_i + step)
        if i >= len(hist):
            self.hist_i, self.buf = None, self.hist_draft
        else:
            self.hist_i, self.buf = i, hist[i]
        self.pos = len(self.buf)

    FKEYS = ('F4', 'F5', 'F6', 'F7', 'F8')        # the bar: five slots above Fn+4 ... Fn+8

    async def handle_fkeys_key(self, k) -> bool:
        """Keys while the function key bar has focus: Left/Right pick one, Enter presses it."""
        n = len(self.FKEYS)
        if k == curses.KEY_LEFT:
            self.fsel = (self.fsel - 1) % n
        elif k == curses.KEY_RIGHT:
            self.fsel = (self.fsel + 1) % n
        elif k == '\t':                       # on through every slot of the bar, then back to the list
            if self.fsel < n - 1:
                self.fsel += 1
            else:                                  # and round to the first heading of the list
                self.focus = 'side'
                heads = [k for _, k, _ in self.side_rows() if k[0] == 'h']
                if heads:
                    self.goto(heads[0])
        elif k == '\x1b':                         # Esc is Tab backwards: one slot to the left, then to the messages, then up the list
            if self.fsel > 0:
                self.fsel -= 1
            elif self.history.get(self.selected):
                self.focus = 'msgs'
                self.msg_sel = len(self.history[self.selected]) - 1
            else:
                self.focus = 'side'
        elif k in ('\x1b', curses.KEY_UP):
            self.focus_back()
        elif k == '\n':
            await self.handle_key(getattr(curses, 'KEY_' + self.FKEYS[self.fsel]))
        elif k in ('/', ':', ' '):
            self.start_typing(k)
        elif isinstance(k, str) and k.isprintable():
            pass
        elif isinstance(k, str) and not (len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C)):
            return False
        else:
            return False
        self.dirty = True
        return True

    def message_on_row_of_list(self) -> int:
        """The message drawn on the screen row where the list's cursor is; the last message when there is none."""
        last = len(self.history.get(self.selected, ())) - 1
        item, row = self.side_row
        shown_item, rows = self.msg_rows
        if item != self.selected or shown_item != self.selected:     # not drawn yet since the selection changed
            return last
        return min(rows.get(row, last), last)

    def start_typing(self, k: str):
        """Space activates the prompt; / or : activates it with a new command, so /q (or :q) always quits."""
        self.focus = 'input'
        if k in ('/', ':'):                   # always a fresh command; a half-written draft is parked on Ctrl-Y
            if self.buf:
                self.kill = self.buf
            self.buf, self.pos = k, 1

    def can_chat(self) -> bool:
        """True when the selected item takes typed messages: a channel or a chat contact."""
        key = self.selected
        if not key or key in (RX_KEY, LOG_KEY):
            return False
        if key[0] == 'c':
            return True
        c = self.selected_contact()
        return c is not None and c.get('type', 1) == 1

    def page_rows(self) -> int:
        """The number of rows a PageUp / PageDown moves in a list or menu: the screen less its frame, one row overlapping."""
        return max(1, self.scr_h - 5)

    def handle_side_key(self, k) -> bool:
        """Keys while the list on the left has focus; returns False to fall through to the input."""
        if k in (curses.KEY_UP, '\x10'):
            self.move(-1)
        elif k in (curses.KEY_DOWN, '\x0e'):
            keys = [r for _, r, _ in self.side_rows()]
            if keys and self.list_cursor(keys) == keys[-1]:         # below the last row: on to the function bar (Up comes back)
                self.fsel = 0
                self.focus = 'fkeys'
            else:
                self.move(1)
        elif k in (curses.KEY_PPAGE, curses.KEY_NPAGE):             # a page of the list at a time
            self.move(-self.page_rows() if k == curses.KEY_PPAGE else self.page_rows())
        elif k in (curses.KEY_HOME, curses.KEY_END):
            rows = self.side_rows()
            if rows:
                self.goto(rows[0 if k == curses.KEY_HOME else -1][1])
        elif k == '\n' and self.cursor_header():
            self.toggle_group(self.cursor_header()[1])
        elif k == curses.KEY_RIGHT and self.cursor_header() and self.cursor_header()[1] in self.collapsed:
            self.toggle_group(self.cursor_header()[1])
        elif k == '\n':
            if self.can_chat():
                self.focus = 'input'          # the prompt is only active after an explicit Enter
            else:
                self.open_contact_menu()      # repeaters, rooms, Log, Radio: nothing to type yet
        elif k == '\t' and self.next_item():
            pass
        elif k in ('\t', curses.KEY_RIGHT):  # to the messages, if there are any, else on to the function keys
            if self.history.get(self.selected):
                self.focus = 'msgs'
                self.msg_sel = self.message_on_row_of_list()
            elif k == '\t':
                self.fsel = 0
                self.focus = 'fkeys'
        elif k == curses.KEY_LEFT and self.cursor_header() and self.cursor_header()[1] not in self.collapsed:
            self.toggle_group(self.cursor_header()[1])
        elif k == '\x1b':                    # Esc is Tab backwards: a row up the list (nothing above the first)
            self.prev_item()
        elif k == curses.KEY_LEFT:
            pass
        elif k in ('/', ':', ' '):
            self.start_typing(k)
        elif isinstance(k, str) and k.isprintable():
            pass                              # other letters do not start a message; Enter, Space, / or : do
        elif isinstance(k, str) and not (len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C)):
            return False
        else:
            return False
        self.dirty = True
        return True

    BAR = (('Help', 'Help'), ('Options', 'Opts'), ('Actions', 'Act'), ('Advert', 'Adv'), ('Quit', 'Quit'))

    def fkey_slots(self, w: int) -> list[tuple[int, int, str]]:
        """The function-key bar as (x, width, text). The built-in keyboard has five keys (4 to 8) fully under
        the screen, so the bar is five slots in a row, each name centred over its key; Fn+4 ... Fn+8 press them.
        A normal (wide) terminal gets a left-aligned bar with the key names instead ('F1 Help  F2 Options ...')."""
        if w >= 70 or not cardputer_keyboard():       # a normal terminal: left-aligned, with the usual function keys
            keys = ('F1', 'F2', 'F6', 'F7', 'F10')        # F1 / F2 / F10 do the same as F4 / F5 / F8
            short_names = w < 50                          # a small window: the short names fit
            out, x = [], 0
            for i, (long, short) in enumerate(self.BAR):
                text = f' {keys[i]} {short if short_names else long} '
                out.append((x, len(text), text))
                x += len(text) + 1
            return out
        slot = max(5, min(w // 5, 8))
        x0 = max(0, (w - 5 * slot) // 2) + 1          # one column right of centre: that is where the keys sit
        out = []
        for i, (long, short) in enumerate(self.BAR):
            name = short if slot < 8 else long
            out.append((x0 + i * slot, slot, name[:slot - 1].center(slot)))
        return out

    @staticmethod
    def sidebar_width(w: int) -> int:
        """A quarter of the width, between MIN_SIDEBAR_W and SIDEBAR_W: a big terminal keeps the full list, the
        CardputerZero's 45 columns give the messages most of the room (the title bar shows the full name)."""
        return max(MIN_SIDEBAR_W, min(SIDEBAR_W, w // 4))

    @staticmethod
    def dim_screen(scr, h: int, w: int):
        """Dim everything drawn so far: what a popup is about to cover must not compete with it."""
        for y in range(h):
            try:
                scr.chgat(y, 0, w - 1 if y == h - 1 else -1, theme_SHADE)
            except curses.error:
                pass

    @staticmethod
    def draw_confirm(scr, h: int, w: int, msg: str):
        """A question that stands out: everything behind it dimmed, the question in a three-row highlighted block."""
        UiMixin.dim_screen(scr, h, w)
        width = min(w - 1, len(msg) + 4)
        x0, y0 = max(0, (w - width) // 2), max(0, h // 2 - 1)
        attr = theme_REV | curses.A_BOLD
        for i, line in enumerate((blank(width), pad(blank((width - len(msg)) // 2) + msg, width), blank(width))):
            if y0 + i < h:
                scr.addnstr(y0 + i, x0, line, w - 1 - x0, attr)
        curses.curs_set(0)

    def draw(self, scr):
        h, w = scr.getmaxyx()
        self.scr_h = h
        if getattr(self, '_bg', None) != theme_BG:     # a theme with its own background paints the whole screen
            scr.bkgd(' ', theme_BG)
            self._bg = theme_BG
            self.repaint = True
        if self.repaint:
            scr.clear()
            self.repaint = False
        scr.erase()
        if h < 6 or w < MIN_SIDEBAR_W + 20:
            scr.addstr(0, 0, 'terminal too small'[:w - 1])
            scr.refresh()
            return
        sw = self.sidebar_width(w)
        mw = w - sw - 1
        body_h = h - 3                      # title row at 0, input + status at bottom

        # sidebar
        rows = self.side_rows()
        keys = [k for _, k, _ in rows]
        cur = self.list_cursor(keys)
        sel_row = keys.index(cur) if cur in keys else 0
        top = max(0, min(sel_row - body_h // 2, len(rows) - body_h))
        for y, (label, key, u) in enumerate(rows[top:top + body_h]):
            tail = f' {u}' if u else ''
            lead = '' if key[0] == 'h' else ' '
            fav = key[0] == 'd' and key[1] in self.favorites
            text = pad(lead + label[:sw - 1 - len(tail) - 2 * len(lead)], sw - 1 - len(tail)) + tail
            if key == cur and self.focus == 'side':
                attr = theme_SEL                     # the cursor, only while the list has the focus
            elif key[0] == 'h':
                attr = theme_HEAD | (curses.A_BOLD if u else 0)
            elif key == self.selected:
                attr = curses.A_BOLD | (theme_FAV if fav else 0)       # the open conversation, when the cursor is elsewhere
            else:
                attr = theme_UNREAD if u else (theme_FAV if fav else curses.A_NORMAL)
            scr.addnstr(1 + y, 0, text, sw - 1, attr)
            if key == self.selected:
                self.side_row = (key, 1 + y)
        for y in range(1, h - 2):
            scr.addstr(y, sw, '│')

        # title
        si = (self.mc.self_info if self.mc else None) or {}
        on_head = self.cursor_header() if self.focus == 'side' else None
        shown = on_head[1] if on_head else (self.name_for(self.selected) if self.selected else None)
        if w < 60:                          # small screen: the conversation and the battery, so the connection state fits
            title = f' {shown} ' if shown else f' {APP} '
            if self.battery_title():
                title += f'· {self.battery_title()} '
            if self.repeater_cli() == 'on' and not on_head:
                title += '(CLI) '
        else:
            title = f' {APP} {__version__} — {si["name"]} ' if si.get('name') else f' {APP} {__version__} '
            if self.battery_title():
                title += f'· bat {self.battery_title()} '
            if shown:
                title += f'— {shown} '
                if self.repeater_cli() == 'on' and not on_head:
                    title += '(CLI) '
        scr.addnstr(0, 0, ' ' * w, w - 1, theme_REV)
        scr.addnstr(0, 0, title, w - 1, theme_REV)
        conn = self.connection_text()          # the title bar only ever shows the connection state
        room = w - 1 - len(title) - 2
        if room > 8:
            conn = conn if len(conn) <= room else conn[:room - 1] + '…'
            scr.addnstr(0, w - 1 - len(conn) - 1, conn, room, theme_REV)

        # messages (with the cursor on a heading: about that group, not the conversation that happens to be open)
        self.last_body_h = body_h
        head = self.cursor_header() if self.focus == 'side' else None
        if head:
            self.msg_rows = (self.selected, {})
            for y, (text, attr) in enumerate(self.group_lines(head[1])[:body_h]):
                scr.addnstr(1 + y, sw + 1, text, mw, attr)
            lines = []
        else:
            lines = self.render_lines(mw)
        if head:
            pass
        elif self.focus == 'msgs':
            self.msg_sel = max(0, min(self.msg_sel, len(self.history.get(self.selected, [])) - 1))
            idx = [i for i, l in enumerate(lines) if l[2] == self.msg_sel]
            if idx:                          # scroll so the highlighted message is visible
                end_now = len(lines) - self.scroll
                if idx[-1] >= end_now:
                    self.scroll = len(lines) - idx[-1] - 1
                elif idx[0] < end_now - body_h:
                    self.scroll = max(0, len(lines) - idx[0] - body_h)
        if not head:
            self.scroll = min(self.scroll, max(0, len(lines) - body_h))
            end = len(lines) - self.scroll
            self.msg_rows = (self.selected, {})
            for y, (text, attr, n) in enumerate(lines[max(0, end - body_h):end]):
                self.msg_rows[1][1 + y] = n
                if self.focus == 'msgs' and n == self.msg_sel:
                    attr = theme_SEL
                scr.addnstr(1 + y, sw + 1, text, mw, attr)
        if self.scroll and not head:
            scr.addnstr(body_h, sw + 1, f'-- {self.scroll} lines up (PgDn) --', mw, curses.A_DIM)

        # input + status
        cli = self.repeater_cli()
        prompt = f'{self.name_for(self.selected)[:14]}# ' if cli == 'on' else '> '
        vis = w - len(prompt) - 1
        start = max(0, self.pos - vis + 1)
        if self.focus != 'input' and not self.buf:
            pass                              # no prompt until Enter, Space or / makes it active
        else:
            scr.addnstr(h - 2, 0, prompt + self.buf[start:start + vis], w - 1)
            if not self.buf and cli:
                hint = ('commands go to the repeater: ver, clock, advert, ...' if cli == 'on'
                        else 'not logged in: Esc, Enter, then "CLI" to manage this repeater')
                scr.addnstr(h - 2, len(prompt), hint, max(0, w - 1 - len(prompt)), curses.A_DIM)
        scr.addnstr(h - 1, 0, blank(w), w - 1, theme_REV)
        for i, (x, width, text) in enumerate(self.fkey_slots(w)):
            chosen = self.focus == 'fkeys' and i == self.fsel
            text = text.replace(' ', NBSP)
            scr.addnstr(h - 1, x, text, max(0, w - 1 - x),
                        ((theme_REV ^ curses.A_REVERSE) | curses.A_BOLD) if chosen else theme_REV)
        scr.move(h - 2, min(w - 1, len(prompt) + self.pos - start))
        curses.curs_set(1 if self.focus == 'input' else 0)
        if self.settings_open:
            self.dim_screen(scr, h, w)         # popups stand out from what is behind them
            self.draw_settings(scr, h, w)
        if self.help_open:
            self.dim_screen(scr, h, w)         # popups stand out from what is behind them
            self.draw_help(scr, h, w)
        if self.noise_open:
            self.draw_noise(scr, h, w)
        if self.details is not None:
            self.dim_screen(scr, h, w)         # popups stand out from what is behind them
            self.draw_details(scr, h, w)
        if self.search:
            self.dim_screen(scr, h, w)         # popups stand out from what is behind them
            self.draw_search(scr, h, w)
        if self.cmenu_open:
            self.dim_screen(scr, h, w)         # popups stand out from what is behind them
            self.draw_cmenu(scr, h, w)
        if self.advert_menu_open:
            self.dim_screen(scr, h, w)         # popups stand out from what is behind them
            self.draw_advert_menu(scr, h, w)
        if self.ask:
            self.dim_screen(scr, h, w)         # popups stand out from what is behind them
            self.draw_ask(scr, h, w)
        if self.confirm_remove:
            self.draw_confirm(scr, h, w, f' {self.confirm_remove["label"]}?  [y] yes  [n/Esc] no ')
        if self.confirm_quit:
            self.draw_confirm(scr, h, w, ' Quit? [y/n] ')
        if self.confirm_stop:
            self.draw_confirm(scr, h, w, ' Keep radio running? [y/n] ')
        scr.refresh()


