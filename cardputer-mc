async def cmd_listen(a) -> int:
    """Print incoming messages as they arrive (those queued while no window was open come first); they also go into the
    shared history, so the chat windows show them too."""
    def hook(app):
        orig = app.add

        def add(key, msg, unread=True):
            orig(key, msg, unread)
            if not msg.mine and key not in (RX_KEY, LOG_KEY):
                print(f'[{app.name_for(key)}] {cli_line(key, msg, a.dates)}', flush=True)
                add.count += 1
        add.count = 0
        app.add = add
    app = await cli_app(hook)
    try:
        t0 = time.time()
        while not (a.count and app.add.count >= a.count) and not (a.seconds and time.time() - t0 >= a.seconds):
            await asyncio.sleep(0.5)
            if int(time.time() - t0) % 5 == 0:
                app.sync_history()
        return 0
    except (asyncio.CancelledError, KeyboardInterrupt):
        return 0
    finally:
        await cli_finish(app)


def run_cli(fn, a) -> int:
    root = logging.getLogger()
    root.handlers[:] = [LOG]
    root.setLevel(logging.INFO)
    try:
        return asyncio.run(fn(a))
    except CliError as e:
        print(f'{APP}: {e}', file=sys.stderr)
        return e.code
    except (RuntimeError, OSError) as e:
        print(f'{APP}: {e}', file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


def terminfo_without_ech_rep():
    """The CardputerZero's launcher terminal ignores two standard escape sequences, ECH (erase N characters) and REP
    (repeat a character), which ncurses uses for runs of equal cells. Those cells then keep their old contents, so
    popups come out garbled. Make a private copy of the terminal's entry without them (like screen/tmux have it)."""
    term = os.environ.get('TERM', '')
    if not term or term.endswith('-mc') or term.startswith(('screen', 'tmux', 'dumb', 'vt')):
        return
    tdir = os.path.join(HOME_DIR, 'terminfo')
    name = term + '-mc'
    if not os.path.exists(os.path.join(tdir, name[0], name)):
        try:
            src = subprocess.run(['infocmp', '-1', '-x', term], capture_output=True, text=True, timeout=10)
            if src.returncode != 0:
                return
            lines = [l for l in src.stdout.splitlines() if not l.startswith('#') and not re.match(r'\s*(ech|rep)=', l)]
            lines[0] = re.sub(r'^[^|,]*', name, lines[0], count=1)
            os.makedirs(tdir, exist_ok=True)
            subprocess.run(['tic', '-x', '-o', tdir, '-'], input='\n'.join(lines) + '\n', text=True,
                           capture_output=True, timeout=10, check=True)
        except (OSError, subprocess.SubprocessError, IndexError):
            return                                   # no infocmp/tic: carry on with the terminal as it is
    os.environ['TERMINFO'] = tdir
    os.environ['TERM'] = name


def _add_radio_parsers(add):
    """The commands for the radio daemon and its radio; `add(name, help)` makes the parser (the same specs serve
    `cardputer-mc radio NAME` and the old top-level names, which stay as hidden aliases)."""
    add('check', 'test the SX1262 wiring (no airtime)')
    add('daemon', 'run the radio daemon in the foreground (chat windows start it by themselves)')
    sp = add('up', 'start the radio daemon if it is not running, then exit')
    sp.add_argument('--keep', action='store_true', help='also keep it running when no window is open (like: radio keep on)')
    sp = add('keep', 'keep the radio daemon running when no window is open: radio keep on | off (no argument: show)')
    sp.add_argument('mode', nargs='?', choices=['on', 'off'])
    sp = add('sound', 'chime on a new message, played by the daemon: radio sound off | private | all | test')
    sp.add_argument('mode', nargs='?', choices=list(SOUND_MODES) + ['test'])
    add('stop', 'stop the radio daemon and switch the radio off')
    add('status', 'is the radio daemon running (and: pid, uptime, windows, messages waiting)')


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog=APP, description='ncurses MeshCore chat for the M5 CardputerZero with the Cap-LoRa-1262',
        epilog=f'First run: {APP} install   (sets up meshcore-pi, a venv and {PI_CONFIG})')
    ap.add_argument('--version', action='version', version=f'{APP} {__version__}')
    ap.add_argument('--remote', metavar='[USER@]HOST', default=os.environ.get('CARDPUTER_MC_REMOTE'),
                    help='use the radio of another machine (the Cardputer): starts its radio daemon over ssh and tunnels to it '
                         '(also CARDPUTER_MC_REMOTE). On a PC set up with: install --client')
    ap.add_argument('--serial', metavar='PORT', default=os.environ.get('CARDPUTER_MC_SERIAL'),
                    help='use a MeshCore USB companion (a Heltec ...) on this serial port, e.g. /dev/ttyUSB0, instead of the '
                         'Cap-LoRa: the radio daemon reads that port (also CARDPUTER_MC_SERIAL)')
