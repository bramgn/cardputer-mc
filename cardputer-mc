class ContactsMixin:
    async def trace_command(self, arg: str):
        """/trace hop,hop,... where a hop is a 1-byte hex hash or a repeater name."""
        toks = [t for t in arg.replace(',', ' ').split() if t]
        if not toks:
            self.status = 'usage: /trace <hop,hop,...>  (hex hash or repeater name)'
            return
        if not self.need_radio():
            return
        route = []
        for t in toks:
            if len(t) == 2 and all(ch in '0123456789abcdefABCDEF' for ch in t):
                route.append(t.lower())
                continue
            hits = [c for c in self.contacts().values()
                    if c.get('type') in (2, 3) and t.lower() in c.get('adv_name', '').lower()]
            if len(hits) != 1:
                self.status = (f'no repeater matches "{t}"' if not hits
                               else f'"{t}" is ambiguous ({len(hits)} repeaters)')
                return
            route.append(hits[0]['public_key'][:2])
        self.status = 'tracing...'
        self.dirty = True

        async def go():
            lines = [f'path: {" > ".join(route)}', ''] + await self.run_trace(route)
            self.show('Trace', lines)
            self.status = 'trace done'
        asyncio.create_task(self.guarded(go()))

    # menu actions that answer with a window; Esc on that window returns to the menu
    WINDOW_ACTIONS = ('details', 'status', 'telemetry', 'clock', 'owner', 'regions', 'neighbours', 'ping', 'trace', 'discover', 'cmdhelp', 'chdetails', 'people')

    CONTACT_ACTIONS = (
        ('Details', 'details'), ('Ping (zero hop)', 'ping'), ('Trace path', 'trace'),
        ('Discover route', 'discover'), ('Set path...', 'setpath'),
        ('Reset path', 'resetpath'), ('Remove contact', 'remove'),
    )

    def group_actions(self, name: str) -> tuple:
        fold = ('Unfold' if name in self.collapsed else 'Fold', 'fold')
        rep_toggle = (f'Show repeaters: {"on" if self.show_repeaters else "off"}', 'repeaters')
        read = ('Mark all read', 'markread')
        if name == 'Channels':
            return (('Add channel...', 'newchan'), read, fold)
        if name == 'Contacts':
            return ((f'Sort: {self.SORTS[self.contact_sort]}', 'sort'),
                    (f'Favorites only: {"on" if self.fav_only else "off"}', 'favonly'), rep_toggle, read,
                    ('Add contact...', 'newcontact'), ('Remove stale contacts...', 'stale'), fold)
        if name == 'Repeaters':
            return (rep_toggle, read, fold)
        return (('Clear Log', 'clearlog'), ('Clear Radio packets', 'clearrx'), read, fold)

    async def group_action(self, name: str, action: str):
        if action == 'fold':
            self.toggle_group(name)
        elif action == 'sort':
            names = list(self.SORTS)
            self.contact_sort = names[(names.index(self.contact_sort) + 1) % len(names)]
            self.save_config()
            self.status = f'contacts sorted by {self.SORTS[self.contact_sort]} (favorites first)'
        elif action == 'markread':
            keys = [k for k, _ in self.groups().get(name, [])]
            n = sum(1 for k in keys if self.unread.pop(k, 0))
            self.status = f'{n} marked read' if n else 'nothing unread'
        elif action == 'newcontact':
            if self.need_radio():
                self.ask = {'label': 'Paste a meshcore:// contact link', 'text': '',
                            'cb': lambda text, _c: self.ask_add_contact(text), 'contact': None}
        elif action == 'stale':
            self.ask = {'label': 'Remove contacts (and repeaters) not heard for how many days?', 'text': '30',
                        'cb': lambda text, _c: self.ask_stale(text), 'contact': None}
        elif action == 'favonly':
            self.fav_only = not self.fav_only
            self.save_config()
            self.status = 'contacts: favorites only' if self.fav_only else 'contacts: all'
        elif action == 'repeaters':
            self.show_repeaters = not self.show_repeaters
            self.status = f'repeaters in the list: {"on" if self.show_repeaters else "off"}'
        elif action == 'newchan':
            if self.need_radio():
                self.ask = {'label': 'New channel: name [secret-hex]  (#name = public hashtag channel)', 'text': '',
                            'cb': lambda text, _c: self.create_channel(text), 'contact': None}
        elif action in ('clearlog', 'clearrx'):
            key = LOG_KEY if action == 'clearlog' else RX_KEY
            self.history[key] = []
            self.unread.pop(key, None)
            self.status = 'Log cleared' if action == 'clearlog' else 'Radio packets cleared'
        self.dirty = True

    def menu_actions(self) -> tuple:
        if self.group_menu:
            return self.group_actions(self.group_menu)
        key = self.selected or ('x',)
        if key[0] == 'c':
            return self.chan_actions(key)
        if key[0] in ('l', 'r'):
            return (('Browse lines' if key[0] == 'l' else 'Browse packets', 'browse'), ('Clear', 'clear'))
        return self.contact_menu_actions()

    def contact_menu_actions(self) -> tuple:
        c = self.selected_contact() or {}
        fav = ('Remove favorite' if c.get('public_key', '')[:12] in self.favorites
               else 'Add favorite', 'favorite')
        acts = list(self.CONTACT_ACTIONS)
        acts.insert(1, fav)
        if c.get('type') in (2, 3):
            # every fetch is its own request, so each one is its own entry (airtime)
            extra = [('Status / battery', 'status'), ('Telemetry', 'telemetry'), ('Clock', 'clock'),
                     ('Owner info', 'owner')]
            if c.get('type') == 2:
                extra += [('Neighbours', 'neighbours'), ('Regions', 'regions')]
            pk = c.get('public_key', '')[:12]
            rep = c.get('type') == 2
            if pk in self.admin:
                if rep:
                    extra.append(('Commands...', 'cmdhelp'))
                extra.append(('Log out', 'logout'))
            elif not rep:                                     # repeaters log in through the CLI entry
                extra.append(('Log in (saved password)' if pk in self.passwords else 'Log in...', 'login'))
            if pk in self.passwords:
                extra.append(('Forget saved password', 'forgetpw'))
            acts[2:2] = extra
        if c.get('type') == 2:
            cli = 'CLI: type commands' if c.get('public_key', '')[:12] in self.admin else 'CLI: log in and type commands'
            return ((cli, 'cli'),) + tuple(acts)
        # only repeaters/rooms answer traces, so no ping for plain clients
        return (('Chat', 'chat'),) + tuple(a for a in acts if a[1] != 'ping')

    def repeater_cli(self) -> str | None:
        """For a selected repeater: 'on' when logged in (typed lines are commands), else 'off'; None for anything else."""
        c = self.selected_contact()
        if not c or c.get('type') != 2:
            return None
        return 'on' if c['public_key'][:12] in self.admin else 'off'

    def selected_contact(self) -> dict | None:
        key = self.selected
        if not key or key[0] != 'd':
            return None
        return next((v for k, v in self.contacts().items() if k.startswith(key[1])), None)

    def open_contact_menu(self):
        """Context menu for whatever is selected in the list: channel, contact, Log or Radio."""
        key = self.selected
        head = self.cursor_header() if self.focus == 'side' else None
        self.group_menu = head[1] if head else None
        if head:                                      # the cursor rests on a heading: actions for that group
            self.cmenu_open, self.cmenu_sel = True, 0
        elif key is None:
            self.status = 'nothing selected'
        elif key[0] == 'd' and self.selected_contact() is None:
            self.status = 'not in the contact list'
        else:
            self.cmenu_open, self.cmenu_sel = True, 0

    async def item_action(self, action: str):
        key = self.selected
        if key is None:
            return
        if key[0] == 'd':
            await self.contact_action(action)
            return
        if action == 'chat':
            self.focus = 'input'
        elif action == 'browse':
            self.focus, self.msg_sel = 'msgs', max(0, len(self.history.get(key, [])) - 1)
        elif action == 'clear':
            self.clear_current(key)
        elif action in ('notify', 'keep', 'people', 'block', 'rename'):
            await self.channel_action(action, key)
        elif action == 'chdetails':
            self.show(f'Channel: {self.name_for(key)}', self.channel_details(key[1]))
        elif action == 'chremove':
            if self.need_radio():
                name = self.name_for(key)
                self.confirm_remove = {'label': f'Remove channel {name}',
                                       'run': lambda: self.apply_remove_channel(key[1], name)}
        self.dirty = True

    def channel_details(self, idx: int) -> list[str]:
        name = next((n for i, n in self.channels if i == idx), '?')
        secret = self.chan_secrets.get(idx, '')
        rows = [('Name', name), ('Slot', str(idx))]
        if name.startswith('#'):
            rows.append(('Kind', 'public hashtag channel (key derived from the name)'))
            rows.append(('Join with', f'/channel {name}'))
        else:
            rows.append(('Kind', 'private channel'))
            rows.append(('Secret', secret or '-'))
            if secret:
                rows.append(('Join with', f'/channel {name} {secret}'))
        out = []
        for a, b in rows:
            lines = textwrap.wrap(b, 52, break_long_words=True) or ['']
            out.append(f'{a + ":":<12}{lines[0]}')
            out += [' ' * 12 + l for l in lines[1:]]
        if secret and not name.startswith('#'):
            out += ['', 'Anyone with this secret can read and post in the channel.']
        return out

    async def apply_remove_channel(self, idx: int, name: str):
        if not self.need_radio():
            return
        async with self.radio_lock:
            r = await self.mc.commands.set_channel(idx, '', bytes(16))
        if r.type == EventType.ERROR:
            self.status = f'remove failed: {describe_error(r.payload)}'
            return
        self.history.pop(('c', idx), None)
        self.chan_secrets.pop(idx, None)
        await self.load_channels()
        self.status = f'removed channel {name}'
        ents = self.entries()
        if ents:
            self.select(ents[0][0])

    def last_signal(self, c: dict) -> tuple | None:
        """Newest (time, snr, rssi, source) heard from this contact: a message or an advert."""
        key = c['public_key'][:12]
        best = self.signal.get(key)
        for m in reversed(self.history.get(('d', key), [])):
            if not m.mine and ('SNR' in m.info or 'RSSI' in m.info):
                if not best or m.recv > best[0]:
                    best = (m.recv, m.info.get('SNR'), m.info.get('RSSI'), 'message')
                break
        return best

    def contact_details(self, c: dict) -> list[str]:
        fmt = lambda t: datetime.fromtimestamp(t).strftime('%Y-%m-%d %H:%M:%S') if t else 'never'
        n = c.get('out_path_len', -1)
        if n in (-1, 255):
            route = 'flood (no stored path)'
        elif n == 0:
            route = 'direct'
        else:
            route = f'{n} hop(s): ' + ' > '.join(
                self.hop_name(h) for h in self.hops_of(c.get('out_path', ''), n, (c.get('out_path_hash_mode') or 0) + 1))
        rows = [('Name', c.get('adv_name', '?')),
                ('Type', NODE_TYPES.get(c.get('type'), '?')),
                ('Public key', c['public_key']),
                ('Last advert', fmt(c.get('last_advert', 0))),
                ('Route', route)]
        sig = self.last_signal(c)
        if sig:
            when, snr, rssi, src = sig
            parts = ([f'SNR {snr} dB'] if snr is not None else []) + \
                    ([f'RSSI {rssi} dBm'] if rssi is not None else [])
            rows.append(('Signal', f'{", ".join(parts)} ({src}, {hhmm(when)})'))
        stat = self.node_stats.get(c['public_key'][:12])
        if stat:
            rows.append(('Battery', f'{battery_text(stat[1].get("bat"))} (status of {hhmm(stat[0])})'))
        lat, lon = c.get('adv_lat'), c.get('adv_lon')
        if lat or lon:
            rows.append(('Position', f'{lat:.5f}, {lon:.5f}'))
            if dist := self.distance_text(lat, lon):
                rows.append(('Distance', dist))
        out = []
        for a, b in rows:
            lines = textwrap.wrap(b, 52, break_long_words=True) or ['']
            out.append(f'{a + ":":<14}{lines[0]}')
            out += [' ' * 14 + l for l in lines[1:]]
        return out

    async def run_trace(self, hops: list[str]) -> list[str]:
        """Send a trace over the given 1-byte hop hashes; returns result lines."""
        t0 = time.monotonic()
        async with self.radio_lock:
            r = await self.mc.commands.send_trace(path=','.join(hops))
        if r.type == EventType.ERROR:
            return [f'trace not sent: {describe_error(r.payload)}']
        tag = int.from_bytes(r.payload['expected_ack'], 'little')
        timeout = r.payload.get('suggested_timeout', 10000) / 1000 + 5
        ev = await self.mc.wait_for_event(EventType.TRACE_DATA,
                                          attribute_filters={'tag': tag}, timeout=timeout)
        if ev is None:
            return ['no reply (timed out)',
                    'Only repeaters and room servers answer traces; the node may be out of range.']
        rtt = time.monotonic() - t0
        nodes = ev.payload.get('path', [])
        out = []
        for i, nd in enumerate(nodes):
            who = self.hop_name(nd['hash']) if 'hash' in nd else 'this radio'
            out.append(f'hop {i + 1}: {who:<30} SNR {nd["snr"]:.2f} dB' if 'snr' in nd
                       else f'hop {i + 1}: {who}')
        complete = sum('snr' in nd for nd in nodes) >= len(hops)
        out.append('' if out else 'empty reply')
        out.append('REACHABLE' if complete else 'incomplete path')
        if complete:
            out.append(f'round trip {rtt * 1000:.0f} ms (including the time to talk to the radio)')
        return out

    async def ping_once(self, c: dict) -> tuple[float | None, list[float], str]:
        """One zero-hop trace to a repeater/room server: (round trip in ms or None, SNR per hop, why it failed)."""
        t0 = time.monotonic()
        async with self.radio_lock:
            r = await self.mc.commands.send_trace(path=c['public_key'][:2])
        if r.type == EventType.ERROR:
            return None, [], f'not sent: {describe_error(r.payload)}'
        tag = int.from_bytes(r.payload['expected_ack'], 'little')
        timeout = r.payload.get('suggested_timeout', 10000) / 1000 + 5
        ev = await self.mc.wait_for_event(EventType.TRACE_DATA, attribute_filters={'tag': tag}, timeout=timeout)
        if ev is None:
            return None, [], 'no reply'
        nodes = ev.payload.get('path', [])
        snrs = [nd['snr'] for nd in nodes if 'snr' in nd]
        if len(snrs) < 1:
            return None, [], 'incomplete reply'
        return (time.monotonic() - t0) * 1000, snrs, ''

    def ping_command(self, arg: str):
        """/ping [name]: zero-hop trace to the selected (or named) repeater or room server."""
        arg = arg.strip().lower()
        if arg:
            hits = [c for c in self.contacts().values()
                    if c.get('type') in (2, 3) and arg in c.get('adv_name', '').lower()]
            if len(hits) != 1:
                self.status = (f'no repeater matches "{arg}"' if not hits
                               else f'"{arg}" is ambiguous ({len(hits)} repeaters)')
                return
            c = hits[0]
        else:
            c = self.selected_contact()
            if c is None:
                self.status = 'usage: /ping [repeater name] (or select a repeater first)'
                return
            if c.get('type') not in (2, 3):
                self.status = f'{c.get("adv_name", "?")} is a normal client: only repeaters and room servers answer pings'
                return
        if self.need_radio():
            asyncio.create_task(self.guarded(self.contact_radio_action('ping', c)))

    async def contact_action(self, action: str):
        c = self.selected_contact()
        if c is None:
            return
        name = c.get('adv_name', '?')
        if action == 'chat':
            self.focus = 'input'
            self.dirty = True
            return
        if action == 'details':
            self.show(f'Contact: {name}', self.contact_details(c))
            return
        if action == 'cli':
            if c['public_key'][:12] in self.admin:
                self.select(('d', c['public_key'][:12]))
                self.focus = 'input'
                self.dirty = True
                return
            action = 'login'                                  # logging in lands in the CLI (apply_login)
        if action == 'login':
            pw = self.passwords.get(c['public_key'][:12])
            if pw is None:
                self.ask_login(c)
            else:
                asyncio.create_task(self.guarded(self.apply_login(pw, c, saved=True)))
            return
        if action == 'forgetpw':
            self.forget_password(c)
            return
        if action == 'logout':
            asyncio.create_task(self.guarded(self.apply_logout(c)))
            return
        if action == 'cmdhelp':
            self.show(f'Commands: {name}', list(self.COMMAND_HELP))
            return
        if action == 'favorite':
            k = c['public_key'][:12]
            self.favorites ^= {k}
            self.save_config()
            self.status = f'{name} {"added to" if k in self.favorites else "removed from"} favorites'
            self.dirty = True
            return
        if action == 'remove':
            self.confirm_remove = {'label': f'Remove {name}', 'run': lambda: self.apply_remove(c)}
            self.dirty = True
            return
        if action == 'setpath':
            self.ask = {'label': f'New path for {name} (hex hops, e.g. 78,64 or 78ac,64e1; empty = direct)',
                        'text': '', 'cb': self.apply_set_path, 'contact': c}
            self.dirty = True
            return
        if not self.need_radio():
            return
        self.menu_task = asyncio.create_task(self.guarded(self.contact_radio_action(action, c)))
        self.menu_task.add_done_callback(self.menu_task_done)

    def menu_task_done(self, _task):
        self.menu_task, self.menu_origin = None, None

    async def contact_radio_action(self, action: str, c: dict):
        name, key = c.get('adv_name', '?'), c['public_key']
        n = c.get('out_path_len', -1)
        hops = self.hops_of(c.get('out_path', ''), n, (c.get('out_path_hash_mode') or 0) + 1) if n not in (-1, 255) else []
        relay = c.get('type') in (2, 3)
        if action in ('status', 'telemetry', 'clock', 'owner', 'regions', 'neighbours'):
            title = {'status': 'Status', 'telemetry': 'Telemetry', 'clock': 'Clock', 'owner': 'Owner info',
                     'regions': 'Regions', 'neighbours': 'Neighbours'}[action]
            self.status = f'asking {name} for {title.lower()}...'
            self.dirty = True
            lines = await getattr(self, f'repeater_{action}')(c)
            self.show(f'{title}: {name}', lines)
            self.status = f'{title.lower()} received' if lines is not self.NO_REPLY else f'no reply from {name}'
        elif action == 'ping':
            self.status = f'pinging {name}...'
            self.dirty = True
            lines = await self.run_trace([key[:2]])
            self.show(f'Ping: {name}', lines)
        elif action == 'trace':
            if not hops and not relay:
                self.status = 'no stored path to trace (try Discover route)'
                return
            route = hops + ([key[:2]] if relay else []) + hops[::-1]
            self.status = f'tracing {name}...'
            self.dirty = True
            lines = [f'path: {" > ".join(route)}', ''] + await self.run_trace(route)
            self.show(f'Trace: {name}', lines)
        elif action == 'discover':
            self.status = f'discovering route to {name}...'
            self.dirty = True
            async with self.radio_lock:
                ev = await self.mc.commands.send_path_discovery_sync(c, min_timeout=15)
            if not ev:
                self.show(f'Route: {name}', ['no response'])
                return
            p = ev.payload
            lines = []
            for label, k in (('Out', 'out_path'), ('In', 'in_path')):
                cnt = p.get(f'{k}_len', 0)
                hs = self.hops_of(p.get(k, ''), cnt, (p.get(f'{k}_hash_mode') or 0) + 1)
                lines.append(f'{label}: {cnt} hop(s)' + (': ' + ' > '.join(self.hop_name(h) for h in hs) if hs else ''))
            self.show(f'Route: {name}', lines)
            self.status = 'route discovered'
        elif action == 'resetpath':
            async with self.radio_lock:
                r = await self.mc.commands.reset_path(key)
            self.status = (f'path reset for {name}' if r.type != EventType.ERROR
                           else f'reset failed: {describe_error(r.payload)}')
        self.dirty = True

    async def apply_set_path(self, text: str, c: dict):
        parts = [p for p in text.replace(' ', '').lower().replace(',', ' ').split() if p]
        size = len(parts[0]) // 2 if parts else 1
        if any(len(p) != 2 * size or size > 3 or len(p) % 2 or any(ch not in '0123456789abcdef' for ch in p) for p in parts):
            self.status = 'path: hex hops of 1 to 3 bytes, all the same length, e.g. 78,64 or 78ac,64e1'
            return
        if not self.need_radio():
            return
        async with self.radio_lock:
            r = await self.mc.commands.change_contact_path(c, ''.join(parts), path_hash_mode=size - 1)
        self.status = (f'path set for {c.get("adv_name", "?")}' if r.type != EventType.ERROR
                       else f'set path failed: {describe_error(r.payload)}')

    async def ask_add_contact(self, text: str):
        """Add contact...: a pasted meshcore:// link; shows who it is and asks before adding."""
        try:
            info = parse_contact_link(text)
        except ValueError as e:
            self.status = str(e)
            return
        if not self.need_radio():
            return
        if any(c['public_key'] == info['key'] for c in self.contacts().values()):
            self.status = f'{info["name"]} is already in the contact list'
            return
        self.confirm_remove = {'label': f'Add {info["name"]} ({info["type"]}, key {info["key"][:8]})',
                               'run': lambda: self.apply_add_contact(info)}
        self.dirty = True

    async def apply_add_contact(self, info: dict):
        if not self.need_radio():
            return
        async with self.radio_lock:
            r = await self.mc.commands.import_contact(info['raw'])
            if r.type != EventType.ERROR:
                await self.mc.ensure_contacts(follow=True)
        if r.type == EventType.ERROR:
            self.status = f'add failed: {describe_error(r.payload)}'
        else:
            self.status = f'added {info["name"]}'
            self.select(('d', info['key'][:12]))
        self.dirty = True

    async def ask_stale(self, text: str):
        """Contacts whose last advert is older than N days (never favourites, never one you have talked to) go after a yes."""
        try:
            days = int(text.strip())
            if days < 1:
                raise ValueError
        except ValueError:
            self.status = 'days must be a whole number, 1 or more'
            return
        if not self.need_radio():
            return
        cutoff = time.time() - days * 86400
        stale = [c for c in self.contacts().values()
                 if c.get('last_advert', 0) < cutoff and c['public_key'][:12] not in self.favorites
                 and ('d', c['public_key'][:12]) not in self.history]
        if not stale:
            self.status = f'no contacts older than {days} days (favorites and chats are kept)'
            return
        self.confirm_remove = {'label': f'Remove {len(stale)} contact(s) not heard for {days}+ days',
                               'run': lambda: self.apply_remove_many(stale)}
        self.dirty = True

    async def apply_remove_many(self, stale: list):
        if not self.need_radio():
            return
        done = 0
        for c in stale:
            async with self.radio_lock:
                r = await self.mc.commands.remove_contact(c['public_key'])
            if r.type == EventType.ERROR:
                self.status = f'removed {done} of {len(stale)}; stopped: {describe_error(r.payload)}'
                break
            self.mc.contacts.pop(c['public_key'], None)
            done += 1
        else:
            self.status = f'removed {done} contact(s)'
        self.dirty = True

    async def apply_remove(self, c: dict):
        if not self.need_radio():
            return
        async with self.radio_lock:
            r = await self.mc.commands.remove_contact(c['public_key'])
        if r.type == EventType.ERROR:
            self.status = f'remove failed: {describe_error(r.payload)}'
            return
        self.mc.contacts.pop(c['public_key'], None)
        self.status = f'removed {c.get("adv_name", "?")}'
        ents = self.contact_entries() or self.entries()
        if ents:
            self.select(ents[0][0])

    async def handle_cmenu_key(self, k):
        n = len(self.menu_actions())
        if k in ('\x1b', curses.KEY_F6):
            self.cmenu_open = False
        elif k == '\t':                                     # Tab walks through the entries, round to the top
            self.cmenu_sel = (self.cmenu_sel + 1) % n
        elif k == curses.KEY_UP:
            self.cmenu_sel = max(0, self.cmenu_sel - 1)
        elif k == curses.KEY_DOWN:
            self.cmenu_sel = min(n - 1, self.cmenu_sel + 1)
        elif k in (curses.KEY_PPAGE, curses.KEY_NPAGE):
            self.cmenu_sel = max(0, min(n - 1, self.cmenu_sel + (-self.page_rows() if k == curses.KEY_PPAGE else self.page_rows())))
        elif k in (curses.KEY_HOME, curses.KEY_END):
            self.cmenu_sel = 0 if k == curses.KEY_HOME else n - 1
        elif k == '\n':
            act = self.menu_actions()[self.cmenu_sel][1]
            self.cmenu_open = act in ('notify', 'keep', 'favonly', 'repeaters', 'sort')      # settings that cycle keep the menu open
            self.menu_origin = (self.selected, self.cmenu_sel) if act in self.WINDOW_ACTIONS and not self.group_menu else None
            if self.group_menu:
                await self.group_action(self.group_menu, act)
            else:
                await self.item_action(act)
            popup = self.ask or self.confirm_remove
            if popup is not None and 'back' not in popup:    # a question opened by the action: Esc returns to the menu
                popup['back'] = ('cmenu', self.cmenu_sel)
            if self.menu_task is None:                       # no window coming: forget the way back
                self.menu_origin = None
        elif isinstance(k, str) and len(k) == 1 and ord(k) in (CTRL_Q, CTRL_C):
            self.quit = True
        self.dirty = True

    async def handle_ask_key(self, k):
        a = self.ask
        if k == '\x1b':
            self.ask = None
            self.restore(a.get('back'))
        elif k == '\n':
            self.ask = None
            await a['cb'](a['text'], a['contact'])
        elif k == '\t' and 'check' in a:
            a['check'] = not a['check']
        elif k in ('\x7f', '\b') or k == curses.KEY_BACKSPACE:
            a['text'] = a['text'][:-1]
        elif isinstance(k, str) and k.isprintable():
            a['text'] += k
        self.dirty = True

    def draw_cmenu(self, scr, h, w):
        bw = min(w - 2, 40)
        acts = self.menu_actions()
        vis = max(1, min(len(acts), h - 5))                  # long menus scroll on small screens
        off = max(0, min(self.cmenu_sel - vis // 2, len(acts) - vis))
        bh = vis + 3
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for y in range(bh):
            scr.addstr(y0 + y, x0, blank(bw), theme_REV)
        scr.addnstr(y0, x0 + 1, 'Actions: ' + (self.group_menu or self.name_for(self.selected)), bw - 2, theme_REV | curses.A_BOLD)
        for i, (label, _) in enumerate(acts[off:off + vis], off):
            attr = theme_SEL if i == self.cmenu_sel else theme_REV
            scr.addnstr(y0 + 1 + i - off, x0 + 1, pad(label, bw - 2), bw - 2, attr)
        scr.addnstr(y0 + bh - 1, x0 + 1, 'Enter select · Esc close' + (' · ↑/↓ more' if vis < len(acts) else ''),
                    bw - 2, theme_REV | curses.A_DIM)
        curses.curs_set(0)

    def draw_ask(self, scr, h, w):
        a = self.ask
        bw = min(w - 2, 70)
        y0, x0 = max(0, h // 2 - 2), max(0, (w - bw) // 2)
        for y in range(4):
            scr.addstr(y0 + y, x0, blank(bw), theme_REV)
        scr.addnstr(y0, x0 + 1, a['label'], bw - 2, theme_REV | curses.A_BOLD)
        shown = '*' * len(a['text']) if a.get('secret') else a['text']
        scr.addnstr(y0 + 1, x0 + 1, pad(shown + '_', bw - 2), bw - 2, theme_REV)
        if 'check' in a:
            scr.addnstr(y0 + 2, x0 + 1, f'[{"x" if a["check"] else " "}] {a["check_label"]}  (Tab)', bw - 2, theme_REV)
        scr.addnstr(y0 + 3, x0 + 1, 'Enter apply · Esc cancel', bw - 2, theme_REV | curses.A_DIM)
        curses.curs_set(0)


