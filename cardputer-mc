def _running_pids():
    """pids of a running cardputer-mc or of the meshcore-pi it started (other than this process)."""
    me, found = os.getpid(), []
    script = os.path.realpath(__file__)
    for entry in os.listdir('/proc'):
        if not entry.isdigit() or int(entry) == me:
            continue
        try:
            with open(f'/proc/{entry}/cmdline', 'rb') as f:
                args = f.read().decode(errors='replace').split('\0')
        except OSError:
            continue
        if any(a.startswith(PI_DIR + os.sep) and a.endswith('meshcore.py') for a in args) or \
                (script in [os.path.realpath(a) for a in args[1:3] if a] and 'uninstall' not in args):
            found.append(int(entry))
    return found


def uninstall(argv):
    ap = argparse.ArgumentParser(prog=f'{APP} uninstall', description='Remove what install created.')
    ap.add_argument('--keep-identity', action='store_true',
                    help='keep config.toml (this node\'s private key), contacts.mesh and channels.json')
    ap.add_argument('--purge', action='store_true', help=f'also remove chat history and UI settings ({CONFIG_DIR})')
    ap.add_argument('-y', '--yes', action='store_true', help='do not ask for confirmation')
    opts = ap.parse_args(argv)

    home = os.path.realpath(HOME_DIR)
    if home in ('/', os.path.realpath(os.path.expanduser('~'))) or not any(
            os.path.lexists(os.path.join(home, n)) for n in
            ('venv', 'meshcore-pi', 'config.toml', 'contacts.mesh', 'channels.json', 'meshcore.log', 'local-radio.log',
             '.lgd-nfy0')):
        print(f'nothing to remove: {HOME_DIR} does not look like a {APP} install')
        return 0
    pids = _running_pids()
    if pids:
        raise SystemExit(f'{APP} or its radio daemon is still running (pid {", ".join(map(str, pids))}); close it, or run: {APP} radio stop')

    remove = [os.path.join(home, n) for n in sorted(os.listdir(home))
              if not (opts.keep_identity and n in IDENTITY_FILES)]
    link = os.path.join(os.path.expanduser('~/.local/bin'), APP)
    if os.path.islink(link) and os.path.realpath(link) == os.path.realpath(__file__):
        remove.append(link)
    if opts.purge and os.path.isdir(CONFIG_DIR):
        remove.append(CONFIG_DIR)
    print('Will remove:')
    for p in remove:
        print('  ' + p)
    if opts.keep_identity:
        print(f'Keeping: {", ".join(n for n in IDENTITY_FILES if os.path.exists(os.path.join(home, n)))}')
    elif os.path.exists(PI_CONFIG):
        print(f'\nWarning: {PI_CONFIG} holds this node\'s private key. Removing it gives you a new identity,\n'
              f'and others will see a new node. To keep it: {APP} uninstall --keep-identity')
    print('The apt packages are left in place.')
    if not opts.yes and input('Continue? [y/N] ').strip().lower() != 'y':
        print('aborted')
        return 1
    for p in remove:
        if os.path.isdir(p) and not os.path.islink(p):
            shutil.rmtree(p)
        else:
            os.remove(p)                 # files, symlinks and the FIFO that lgpio leaves behind (.lgd-nfy0)
    if not opts.keep_identity:
        try:
            os.rmdir(home)
        except OSError:
            pass
    print(f'Removed. Reinstall with: {os.path.realpath(__file__)} install')
    return 0


def check() -> int:
    """Wiring test for this board's SX1262, without airtime: RESET/BUSY handshake, an SPI read, the I2C expander
    and DIO1. Uses the pins from config.toml (the CardputerZero's own mapping when there is none)."""
    import glob
    import tomllib
    results = []

    def report(ok, text):
        print(f'[{ {True: " ok ", False: "FAIL", None: "info"}[ok] }] {text}', flush=True)
        results.append(ok)

    try:
        with open(PI_CONFIG, 'rb') as f:
            cfg = tomllib.load(f)
        icfg = cfg['interface'][(cfg.get('interfaces') or ['caplora'])[0]]
    except (OSError, KeyError, ValueError, tomllib.TOMLDecodeError):
        icfg = {}
        report(None, f'no usable {PI_CONFIG}; using the CardputerZero mapping')
    spi, cs = icfg.get('spi', 0), icfg.get('cs', 1)
    reset, busy, irq = icfg.get('reset', 26), icfg.get('busy', 22), icfg.get('irq', 23)
    report(None, f'pins: RESET GPIO{reset}, BUSY GPIO{busy}, DIO1 GPIO{irq}, SPI{spi} CS{cs}')

    pids = _running_pids()
    if pids:
        report(False, f'{APP} or its radio daemon is running (pid {", ".join(map(str, pids))}); close it, or run: {APP} radio stop')
        return 1
    dev = f'/dev/spidev{spi}.{cs}'
    if not os.path.exists(dev):
        report(False, f'{dev} does not exist (is SPI enabled?)')
        return 1
    report(True, f'{dev} exists')
    try:
        import RPi.GPIO as GPIO
        import spidev
    except ImportError as e:
        report(False, f'missing Python module ({e}); run: {APP} install')
        return 1

    try:
        with open(LED_5V) as f:
            old_5v = f.read().strip()
    except OSError:
        old_5v = None
    GPIO.setwarnings(False)
    GPIO.setmode(GPIO.BCM)
    spidev_dev = None
    try:
        _set_5v(True)
        time.sleep(0.5)
        report(None if old_5v is not None else False,
               '5V supply of the module switched on' if old_5v is not None else f'no {LED_5V}: cannot switch the 5V supply')
        try:
            GPIO.setup(reset, GPIO.OUT, initial=GPIO.HIGH)
            GPIO.setup(busy, GPIO.IN)
        except Exception as e:
            report(False, f'GPIO{reset}/GPIO{busy} cannot be claimed ({e}); something else uses them')
            return 1

        # 1. RESET / BUSY: BUSY is high while the chip is in reset and drops once it has started
        def wait_busy_low(limit=1.0):
            t = time.perf_counter()
            while GPIO.input(busy):
                if time.perf_counter() - t > limit:
                    return None
                time.sleep(0.0005)
            return (time.perf_counter() - t) * 1000

        GPIO.output(reset, GPIO.LOW)
        time.sleep(0.05)
        in_reset = GPIO.input(busy)
        GPIO.output(reset, GPIO.HIGH)
        time.sleep(0.001)
        settle = wait_busy_low()
        if in_reset and settle is not None:
            report(True, f'BUSY (GPIO{busy}) follows RESET (GPIO{reset}): high in reset, low again {settle + 1:.0f} ms after release')
        elif not in_reset:
            report(False, f'BUSY (GPIO{busy}) did not go high while RESET (GPIO{reset}) was held: wrong pins, or no SX1262')
        else:
            report(False, f'BUSY (GPIO{busy}) stays high after RESET: chip not starting (no power, or wrong pin)')

        # 2. the chip over SPI: GetStatus and the LoRa sync word register (reset default 0x1424)
        try:
            spidev_dev = spidev.SpiDev()
            spidev_dev.open(spi, cs)
            spidev_dev.max_speed_hz = 1000000
            spidev_dev.mode = 0
            if wait_busy_low() is None:
                raise RuntimeError('BUSY never went low')
            status = spidev_dev.xfer2([0xC0, 0x00])[1]
            mode = (status >> 4) & 7
            modes = {2: 'STDBY_RC', 3: 'STDBY_XOSC', 4: 'FS', 5: 'RX', 6: 'TX'}
            report(mode in (2, 3), f'SX1262 answers on SPI{spi}.{cs}: status 0x{status:02X}, chip mode {modes.get(mode, mode)}')
            wait_busy_low()
            sync = spidev_dev.xfer2([0x1D, 0x07, 0x40, 0x00, 0x00, 0x00])[4:6]
            report(sync == [0x14, 0x24], f'sync word register 0x0740 reads 0x{sync[0]:02X}{sync[1]:02X} (reset default 0x1424)')
        except Exception as e:
            report(False, f'SPI to the SX1262 failed: {e}')

        # 3. the I2C expander (PI4IOE5V6408, address 0x43): read only
        import fcntl
        found = None
        for bus in sorted(glob.glob('/dev/i2c-*')):
            try:
                fd = os.open(bus, os.O_RDWR)
            except OSError:
                continue
            try:
                fcntl.ioctl(fd, 0x0703, 0x43)                     # I2C_SLAVE
                regs = {}
                for reg in (0x01, 0x03, 0x05, 0x0F):
                    os.write(fd, bytes([reg]))
                    regs[reg] = os.read(fd, 1)[0]
                if regs[0x01] >> 5 == 5:                         # manufacturer id of the PI4IOE5V6408
                    found = (bus, regs)
                    break
            except OSError:
                pass
            finally:
                os.close(fd)
        if found:
            bus, regs = found
            mode = 'output' if regs[0x03] & 1 else 'input'
            report(True, f'IO expander PI4IOE5V6408 found at 0x43 on {bus}; P0 is an {mode}, reads {"high" if regs[0x0F] & 1 else "low"}')
        else:
            report(False, 'no IO expander at 0x43 on any I2C bus (is the Cap fitted and the 5V supply on?)')

        # 4. DIO1 must be free for meshcore-pi to claim
        try:
            GPIO.setup(irq, GPIO.IN)
            report(True, f'DIO1 (GPIO{irq}) can be claimed; reads {"high" if GPIO.input(irq) else "low"} while idle')
        except Exception as e:
            report(False, f'DIO1 (GPIO{irq}) cannot be claimed ({e}); the kernel or another program uses it')
    finally:
        if spidev_dev is not None:
            spidev_dev.close()
        GPIO.cleanup()
        if old_5v is not None:
            try:
                with open(LED_5V, 'w') as f:
                    f.write(old_5v)
            except OSError:
                pass

    bad = results.count(False)
    print('\nAll checks passed: the wiring matches this configuration.' if not bad
          else f'\n{bad} check(s) failed: this board may not match the pins in {PI_CONFIG}.')
    return 1 if bad else 0


def _bootstrap():
    if sys.argv[1:2] in (['--version'], ['-V']):
        print(f'{APP} {__version__}')
        sys.exit(0)
    if sys.argv[1:2] in (['-h'], ['--help']):
        print(f'usage: {APP} [--remote [USER@]HOST | --serial PORT]\n       {APP} [--remote HOST] send TARGET TEXT... | read [TARGET] | contacts | addcontact LINK | channels | info | advert | ping TARGET | listen\n'
              f'       {APP} radio up [--keep] | stop | status | keep [on|off] | sound [off|private|all|test] | check\n       {APP} update [--check] | completion [--install]\n       {APP} install [--client] [--name NAME] [--key HEX] [-y]\n'
              f'       {APP} uninstall [--keep-identity] [--purge] [-y]\n       {APP} --version   ({APP} COMMAND --help for details)\n')
        print(__doc__.split('State lives')[0].strip())
        sys.exit(0)
    if sys.argv[1:2] == ['install']:
        sys.exit(install(sys.argv[2:]))
    if sys.argv[1:2] == ['uninstall']:
        sys.exit(uninstall(sys.argv[2:]))
    if os.path.realpath(sys.prefix) != os.path.realpath(VENV_DIR):
        if not os.path.isfile(VENV_PY):
            sys.exit(f'{APP}: not set up yet. Run: {sys.argv[0]} install')
        os.execv(VENV_PY, [VENV_PY, os.path.realpath(__file__)] + sys.argv[1:])


_bootstrap()

