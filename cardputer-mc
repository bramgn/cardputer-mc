def theme_init_colors(theme: str = 'blue'):
    global theme_SHADE, theme_BG, theme_FAV, theme_REV, theme_SEL, theme_HEAD, theme_UNREAD, theme_ME, theme_NOTE, theme_FAIL, theme_GOOD_BAR, theme_BAD_BAR
    pairs = theme_THEMES.get(theme)
    if pairs is None or not curses.has_colors():
        theme_BG = curses.A_NORMAL
        theme_SHADE = curses.A_DIM
        theme_REV, theme_SEL, theme_HEAD = curses.A_REVERSE, curses.A_REVERSE | curses.A_BOLD, curses.A_BOLD | curses.A_UNDERLINE
        theme_UNREAD, theme_ME, theme_NOTE, theme_FAIL = curses.A_BOLD, curses.A_DIM, curses.A_DIM, curses.A_BOLD
        theme_GOOD_BAR, theme_BAD_BAR = curses.A_BOLD, curses.A_BOLD | curses.A_UNDERLINE
        return
    curses.start_color()
    curses.use_default_colors()
    for n, (fg, bg) in enumerate(pairs, 1):
        curses.init_pair(n, theme_col(fg), theme_col(bg))
    # favourites: a clear yellow. The basic 'yellow' (colour 3) shows as orange on many terminals, so use the 256-colour 226
    # (or the bright yellow 11) when the terminal has them
    fav = 226 if curses.COLORS >= 256 else 11 if curses.COLORS >= 16 else theme_col('yellow')
    if theme in theme_FAV_COLOR:
        fav = theme_FAV_COLOR[theme] if curses.COLORS >= 256 else theme_col('magenta')
    curses.init_pair(10, fav, theme_col(theme_BACKGROUND[theme][1]) if theme in theme_BACKGROUND else theme_col('default'))
    if theme in theme_BACKGROUND:
        curses.init_pair(11, theme_col(theme_BACKGROUND[theme][0]), theme_col(theme_BACKGROUND[theme][1]))
        theme_BG = curses.color_pair(11)
    else:
        theme_BG = curses.A_NORMAL
    theme_FAV = curses.color_pair(10)
    theme_REV = curses.color_pair(1)
    theme_SEL = curses.color_pair(2) | curses.A_BOLD
    theme_HEAD = curses.color_pair(3) | curses.A_BOLD
    theme_UNREAD = curses.color_pair(4) | curses.A_BOLD
    theme_ME = curses.color_pair(5)
    theme_NOTE = curses.color_pair(6)
    theme_FAIL = curses.color_pair(7) | curses.A_BOLD
    if theme in theme_BACKGROUND:                  # a theme with its own (light) background: darken it
        curses.init_pair(12, theme_col(244), theme_col(233))
    else:                                          # the terminal's own background stays as it is: only the text turns dark grey
        curses.init_pair(12, theme_col(240), theme_col('default'))
    theme_SHADE = curses.color_pair(12) | (curses.A_DIM if curses.COLORS < 256 else 0)
    curses.init_pair(8, curses.COLOR_BLACK, curses.COLOR_GREEN)
    curses.init_pair(9, curses.COLOR_WHITE, curses.COLOR_RED)
    theme_GOOD_BAR = curses.color_pair(8)
    theme_BAD_BAR = curses.color_pair(9) | curses.A_BOLD


