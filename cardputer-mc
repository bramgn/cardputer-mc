def parse_contact_link(text: str) -> dict:
    """A meshcore:// contact link is the hex of the contact's advert packet. Returns the raw bytes and what is in it;
    ValueError (with a readable message) when it is not one."""
    t = ''.join(text.split())
    if t.lower().startswith('meshcore://'):
        t = t[len('meshcore://'):]
    if not t or len(t) % 2 or not re.fullmatch(r'[0-9a-fA-F]+', t):
        raise ValueError('that is not a meshcore:// contact link')
    raw = bytes.fromhex(t)
    if len(raw) < 2 or (raw[0] >> 2) & 0x0F != 4:
        raise ValueError('the link is not a contact (advert) packet')
    path = (raw[1] & 0x3F) * ((raw[1] >> 6) + 1)
    pay = raw[2 + path:]
    if len(pay) < 101:
        raise ValueError('the link is too short')
    flags, off = pay[100], 101
    if flags & 0x10:
        off += 8
    if flags & 0x20:
        off += 2
    if flags & 0x40:
        off += 2
    name = pay[off:].decode(errors='replace').strip('\0 ') if flags & 0x80 else ''
    return {'raw': raw, 'key': pay[:32].hex(), 'type': NODE_TYPES.get(flags & 0x0F, '?'), 'name': name or pay[:4].hex()}


class CliError(Exception):
    def __init__(self, text: str, code: int = 1):
        super().__init__(text)
        self.code = code


async def cli_app(prehook=None) -> 'App':
    """A window without a screen: connects to the radio daemon like the chat does (and so also collects what came in
    meanwhile into the shared history), for the commands below."""
    app = App(argparse.Namespace())
    if prehook:
        prehook(app)
    await app.connect()
    if app.mc is None:
        raise CliError(app.status or 'could not connect to the radio')
    await asyncio.sleep(0)                        # let the title-bar battery task start, then drop it (no screen here)
    if app.keepalive_task:
        app.keepalive_task.cancel()
        app.keepalive_task = None
    return app


async def cli_finish(app: 'App'):
    app.sync_history()
    await app.disconnect()


def cli_contacts(app: 'App') -> list[tuple[tuple, str, dict]]:
    return [(('d', c['public_key'][:12]), c.get('adv_name') or c['public_key'][:8], c) for c in app.contacts().values()]


def resolve_target(app: 'App', text: str) -> tuple[tuple, str]:
    """Contact or channel by name: exact, then prefix, then part of the name (a leading # means a channel)."""
    low = text.strip().lower()
    if not low:
        raise CliError('no target given', 2)
    only_chan = low.startswith('#')
    ch = [(('c', i), n) for i, n in app.channels]
    ct = [] if only_chan else [(k, n) for k, n, _ in cli_contacts(app)]
    norm = lambda n: n.lower().lstrip('#')
    want = low.lstrip('#')
    keys = [] if only_chan or not re.fullmatch(r'[0-9a-f]{4,}', low) else \
        [(k, n) for k, n, c in cli_contacts(app) if c['public_key'].startswith(low)]
    tiers = [[x for x in ch if norm(x[1]) == want] if only_chan else [],
             [x for x in ct if x[1].lower() == low],
             [x for x in ch if norm(x[1]) == want],
             [x for x in ct if x[1].lower().startswith(low)],
             keys,
             [x for x in ct if low in x[1].lower()] + [x for x in ch if want in norm(x[1])]]
    for hits in tiers:
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            raise CliError(f'{text!r} is ambiguous: ' + ', '.join(n for _, n in hits[:8]), 2)
    raise CliError(f'unknown contact or channel {text!r} (see: {APP} contacts, {APP} channels)', 2)


def cli_line(key: tuple, m: 'Msg', date: bool = False) -> str:
    when = datetime.fromtimestamp(m.recv or m.ts or 0).strftime('%Y-%m-%d %H:%M' if date else '%H:%M')
    who = 'me' if m.mine else m.who
    mark = {'acked': ' [delivered]', 'failed': ' [failed]', 'sent': ' [sent]'}.get(m.status, '') if m.mine else ''
    return f'{when} {who + ": " if who else ""}{m.text}{mark}'


def cli_route(app: 'App', c: dict) -> str:
    n = c.get('out_path_len', -1)
    if n in (-1, 255):
        return 'flood'
    if n == 0:
        return 'direct'
    return ' > '.join(app.hop_name(h) for h in app.hops_of(c.get('out_path', ''), n, (c.get('out_path_hash_mode') or 0) + 1))


async def cmd_send(a) -> int:
    text = sys.stdin.read().rstrip('\n') if a.text == ['-'] else ' '.join(a.text)
    if not text.strip():
        raise CliError('nothing to send', 2)
    app = await cli_app()
    try:
        key, name = resolve_target(app, a.target)
        if key[0] == 'd':
            c = next(c for k, _, c in cli_contacts(app) if k == key)
            if c.get('type') == 2:
                raise CliError(f'{name} is a repeater: it takes commands, not chat messages', 2)
        app.selected = key
        await app.send(text)
        msg = next((m for m in reversed(app.history.get(key, [])) if m.mine and m.text == text), None)
        if msg is None or msg.status == 'failed':
            raise CliError(f'send failed: {app.status}')
        if key[0] == 'c':
            print(f'sent to {name}')
            return 0
        if a.no_wait:
            print(f'sent to {name} (not waiting for the acknowledgement)')
            return 0
        t0 = time.time()
        wait = a.timeout or (app.retries + 1) * (msg.info.get('suggested_timeout', 10000) / 1000 + 2) + 3
        while msg.status == 'sent' and time.time() - t0 < wait:
            await asyncio.sleep(0.25)
        if msg.status == 'acked':
            print(f'delivered to {name} ({time.time() - t0:.1f} s)')
            return 0
        raise CliError(f'no acknowledgement from {name} after {time.time() - t0:.0f} s' if msg.status == 'sent'
                       else f'send failed: {app.status}')
    finally:
        await cli_finish(app)


