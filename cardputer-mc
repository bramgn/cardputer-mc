def read_key(scr):
    """One key from curses. Alt+key arrives as ESC followed at once by the key: returned as '\\x1b' + key."""
    k = scr.get_wch()
    if k == '\x1b':
        try:
            nxt = scr.get_wch()
        except curses.error:
            return k                          # a lone Esc
        if isinstance(nxt, str):
            return k + nxt
        curses.unget_wch(nxt)                 # Esc, then a function key
    return k


async def ui(scr, app: App):
    curses.curs_set(1)
    theme_init_colors(app.theme)
    scr.nodelay(True)
    scr.keypad(True)
    while not app.quit:
        try:
            k = read_key(scr)
        except curses.error:
            k = None
        if k is None:
            if app.dirty:
                app.dirty = False
                app.draw(scr)
            await asyncio.sleep(0.03)
            continue
        if k == curses.KEY_RESIZE:
            app.dirty = True
            continue
        await app.handle_key(k)

async def run(scr, args):
    app = App(args)
    if app.auto_connect:
        app.start_auto_connect()
    async def autosave():
        while True:
            await asyncio.sleep(5)
            app.sync_history()
    saver = asyncio.create_task(autosave())

    async def update_notice():
        await asyncio.sleep(10)                          # after the connection message has had its moment
        newer = await asyncio.to_thread(update_available)
        if newer:
            app.status = f'update available ({newer}): run {APP} update'
            log.info(app.status)
            app.dirty = True
    notice = asyncio.create_task(update_notice())
    try:
        await ui(scr, app)
    finally:
        notice.cancel()
        saver.cancel()
        app.sync_history()
        await app.disconnect()
        if app.stop_daemon_on_quit:
            await asyncio.to_thread(stop_daemon_quietly)

