class FocusTrail:
    """`focus` remembers where you came from, so Esc goes back one step instead of straight to the list.
    Going to a place that is already on the trail cuts the trail back to it (no loops)."""
    _focus = None

    @property
    def focus(self):
        return self._focus

    @focus.setter
    def focus(self, new):
        old = self._focus
        if new == old:
            return
        trail = self.__dict__.setdefault('focus_trail', [])
        if new in trail:
            del trail[trail.index(new):]
        elif old is not None:
            trail.append(old)
        self._focus = new

    def focus_back(self):
        trail = self.__dict__.setdefault('focus_trail', [])
        self._focus = trail.pop() if trail else 'side'


class App(FocusTrail, ConnectionMixin, MessagingMixin, SettingsMixin, ContactsMixin, ChannelsMixin, RepeaterMixin, CommandsMixin, UiMixin):
    @property
    def status(self) -> str:
        return self._status

    @property
    def keep_daemon(self) -> bool:                # keep the radio on when the last window closes (shared: file, not memory)
        return _keep_daemon()

    @keep_daemon.setter
    def keep_daemon(self, value: bool):
        set_setting('keep_daemon', bool(value))

    @property
    def sound(self) -> str:                       # 'off' | 'private' | 'all', played by the daemon on a new message
        return sound_mode()

    @sound.setter
    def sound(self, value: str):
        set_setting('sound', value)

    @property
    def show_repeaters(self) -> bool:
        return self._show_repeaters

    @show_repeaters.setter
    def show_repeaters(self, value: bool):
        self._show_repeaters = value
        self.save_config()

    def save_config(self):
        cfg = {'show_repeaters': self._show_repeaters, 'auto_connect': self.auto_connect,
               'keep_daemon': self.keep_daemon, 'sound': self.sound, 'theme': self.theme, 'favorites': sorted(self.favorites), 'channels': self.chan_prefs, 'retries': self.retries,
               'collapsed': sorted(self.collapsed), 'fav_only': self.fav_only, 'contact_sort': self.contact_sort}
        try:
            os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
            with open(CONFIG_FILE, 'w') as f:
                json.dump(cfg, f, indent=2)
        except OSError as e:
            log.warning('could not save config: %s', e)

    def sync_history(self):
        """Write the history, after folding in what other windows have written to the same file meanwhile."""
        import fcntl
        shown = None                          # keep the highlighted message highlighted when the list shifts
        msgs = self.history.get(self.selected) if self.selected else None
        if self.focus == 'msgs' and msgs and 0 <= self.msg_sel < len(msgs):
            shown = msgs[self.msg_sel]
        try:
            os.makedirs(os.path.dirname(HISTORY_FILE), exist_ok=True)
            with open(HISTORY_FILE + '.lock', 'w') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                disk, disk_cleared = read_history_file()
                for k, t in disk_cleared.items():
                    self.cleared[k] = max(self.cleared.get(k, 0), t)
                own = {k for k in self.history if k and k not in (RX_KEY, LOG_KEY)}
                for key in own | set(disk):
                    merged = merge_msgs(self.history.get(key, []), disk.get(key, []), self.cleared.get(json.dumps(key), 0))
                    if merged or key in self.history:
                        self.history[key] = merged[-self.keep_for(key):]
                raw = {json.dumps(k): [asdict(m) for m in ms if m.who != '*']
                       for k, ms in self.history.items() if k and k not in (RX_KEY, LOG_KEY)}
                raw = {k: v for k, v in raw.items() if v}
                if self.cleared:
                    raw['__cleared__'] = self.cleared
                data = json.dumps(raw, default=lambda o: o.hex() if isinstance(o, (bytes, bytearray)) else str(o))
                try:
                    with open(HISTORY_FILE) as f:
                        current = f.read()
                except OSError:
                    current = None
                if data != current:           # also rewrites a file that could not be read
                    with open(HISTORY_FILE + '.tmp', 'w') as f:
                        f.write(data)
                    os.replace(HISTORY_FILE + '.tmp', HISTORY_FILE)
        except OSError as e:
            log.warning('could not save history: %s', e)
        if shown is not None:
            msgs = self.history.get(self.selected, [])
            self.msg_sel = next((i for i, m in enumerate(msgs) if m is shown), max(0, min(self.msg_sel, len(msgs) - 1)))
        self.dirty = True

    @status.setter
    def status(self, text: str):
        self._status = text
        log.info(text)

    def __init__(self, args):
        self.args = args
        self.mc: MeshCore | None = None
        self.connecting = False
        self.contact_cache: dict = {}        # last known contacts, kept after disconnect
        self.channels: list[tuple[int, str]] = []
        self.history: dict[tuple, list[Msg]]
        self.history, self.cleared = read_history_file()      # self.cleared: when each conversation was last emptied
        self.unread: dict[tuple, int] = {}
        self.selected: tuple | None = None
        cfg = load_config()
        self._show_repeaters = bool(cfg.get('show_repeaters', True))
        self.auto_connect = bool(cfg.get('auto_connect', True))
        self.favorites: set[str] = set(cfg.get('favorites', []))     # contact key prefixes (12 hex)
        self.chan_prefs: dict[str, dict] = cfg.get('channels') if isinstance(cfg.get('channels'), dict) else {}
        self.retries = max(0, min(MAX_RETRIES, int(cfg.get('retries', 1))))
        self.theme = cfg.get('theme') if cfg.get('theme') in theme_THEMES else 'blue'
        self.scroll = 0                      # lines scrolled up from bottom
        self.buf = ''
        self.pos = 0
        self.status = 'disconnected'
        self.pending_acks: dict[str, Msg] = {}
        self.dirty = True
        self.repaint = False
        self.quit = False
        self.settings_open = False
        self.set_sel = 0
        self.focus_trail: list[str] = []
        self.cursor: tuple | None = None     # a heading (Channels, Contacts, ...) the list cursor is on, else None
        self.collapsed: set[str] = set(cfg.get('collapsed', []))
        self.fav_only = bool(cfg.get('fav_only', False))      # Contacts: only favourites (and what has unread / is open)
        self.contact_sort = cfg.get('contact_sort') if cfg.get('contact_sort') in self.SORTS else 'advert'
        self.group_menu: str | None = None   # the heading the Actions menu is open for, else None (the open conversation)
        self.focus = 'side'                  # 'side' (list) | 'input' | 'msgs' | 'fkeys' (function key bar)
        self.fsel = 0                        # highlighted entry of the function key bar
        self.keepalive_task: asyncio.Task | None = None
        self.pending_g = False               # a single g waiting for its second one (gg = top)
        self.side_row: tuple = (None, 0)     # (item, screen row) of the selected list entry, as last drawn
        self.msg_rows: tuple = (None, {})    # (item, {screen row: message index}) of the messages, as last drawn
        self.chan_secrets: dict[int, str] = {}   # slot -> secret hex, from the last channel load
        self.pending_repeats: dict[tuple, tuple] = {}   # (timestamp, 'name: text') -> (Msg, sent at) of recent channel sends
        self.search: dict | None = None      # /search results overlay
        self.msg_sel = 0
        self.last_body_h = 0
        self.details: list[str] | None = None
        self.details_title = 'Message details'
        self.details_scroll = 0
        self.scr_h = 24
        self.help_hscroll = self.details_hscroll = 0     # sideways scroll of the Help / details windows (long lines)
        self.details_back: tuple | None = None   # (key, menu row) of the context menu to return to
        self.menu_origin: tuple | None = None    # set when a menu action may open a window
        self.menu_task: asyncio.Task | None = None
        self.cmenu_open = False
        self.cmenu_sel = 0
        self.advert_menu_open = False
        self.advert_back = None                  # where Esc on the advert menu goes back to ('options')
        self.advert_sel = 0
        self.ask: dict | None = None         # single-line input prompt: label/text/cb
        self.confirm_remove: dict | None = None
        self.help_open = False
        self.help_scroll = 0
        self.noise_open = False
        self.input_hist: list[str] = self.load_input_history()
        self.hist_i: int | None = None        # position in input_hist while Up / Down are walking through it
        self.hist_draft = ''                  # what was being typed when the walk began
        self.rx_recent: collections.deque = collections.deque(maxlen=30)     # recent text packets from the radio log, for the route of a message
        self.noise_hist: collections.deque = collections.deque(maxlen=NOISE_KEEP)      # noise floor readings, dBm
        self.noise_misses = 0
        self.noise_unsupported = False
        self.passwords: dict[str, str] = self.load_passwords()   # repeater key prefix -> remembered password
        self.admin: set[str] = set()         # repeaters / rooms we are logged in to (key prefixes)
        self.radio_bat: int | None = None        # companion battery in mV (None when it has no gauge)
        self.bat_local = local_battery()         # (percent, status, volts) of this machine, for the title bar
        self.node_stats: dict[str, tuple] = {}   # key prefix -> (time, status dict) from the last status request
        self.signal: dict[str, tuple] = {}   # key prefix -> (time, snr, rssi, source) from adverts
        self.radio_lock = asyncio.Lock()     # the library can't tell concurrent replies apart
        self.kill = ''                       # readline kill ring (one slot)
        self.confirm_quit = False
        self.confirm_stop = False            # second quit question: the last window, switch the radio off too?
        self.stop_daemon_on_quit = False
        self.set_edit: str | None = None     # text being edited, None when not editing
        LOG.sink = self.on_log_record        # status messages and library logs go to the Log entry
        for rec in list(LOG.records):
            self.on_log_record(rec)
        LOG.records.clear()

    SORTS = {'advert': 'newest advert', 'name': 'name A-Z', 'message': 'last message'}

    def contact_entries(self) -> list[tuple[tuple, str]]:
        """People first, then repeaters and room servers; each newest first (favourites on top)."""
        out, infra = [], []
        known = set()
        def order(c):                                  # favourites first, then by the chosen sort
            fav = c['public_key'][:12] not in self.favorites
            if self.contact_sort == 'name':
                return (fav, (c.get('adv_name') or c['public_key']).lower())
            if self.contact_sort == 'message':
                msgs = self.history.get(('d', c['public_key'][:12]))
                return (fav, -((msgs[-1].recv or msgs[-1].ts) if msgs else 0), -c.get('last_advert', 0))
            return (fav, -c.get('last_advert', 0))
        contacts = sorted(self.contacts().values(), key=order)
        for c in contacts:
            key = ('d', c['public_key'][:12])
            known.add(key)
            is_rep = c.get('type') == 2
            infra_node = c.get('type') in (2, 3)
            fav = key[1] in self.favorites
            if is_rep and not self.show_repeaters and not fav and key not in self.history:
                continue
            if self.fav_only and not fav and key != self.selected and not self.unread.get(key):
                continue
            (infra if infra_node else out).append((key, c.get('adv_name') or c['public_key'][:8]))
        for key in self.history:
            if key and key[0] == 'd' and key not in known:
                out.append((key, key[1][:8]))
        return out + infra

    def is_infra(self, key: tuple) -> bool:
        """Repeater or room server (listed under Repeaters)."""
        return key[0] == 'd' and any(c.get('type') in (2, 3) for k, c in self.contacts().items()
                                     if k.startswith(key[1]))

    def entries(self) -> list[tuple[tuple, str]]:
        ch = [(('c', i), n) for i, n in self.channels]
        return ch + self.contact_entries() + [(LOG_KEY, 'Log'), (RX_KEY, 'Radio')]

    def name_for(self, key: tuple) -> str:
        for k, n in self.entries():
            if k == key:
                return n
        return key[1][:8] if key[0] == 'd' else f'ch{key[1]}'

    def add(self, key: tuple, msg: Msg, unread: bool = True):
        msgs = self.history.setdefault(key, [])
        msgs.append(msg)
        if key[0] == 'c' and len(msgs) > self.keep_for(key):
            del msgs[0]
        if key in (RX_KEY, LOG_KEY) and len(msgs) > LOG_LINES:
            del msgs[0]
            self.msg_sel = max(0, self.msg_sel - 1)
        if key == self.selected:
            self.scroll = 0
            if self.focus == 'msgs' and self.msg_sel == len(msgs) - 2:
                self.msg_sel = len(msgs) - 1
        elif unread and self.counts_unread(key, msg):
            self.unread[key] = self.unread.get(key, 0) + 1
        self.dirty = True

    def on_log_record(self, record):
        """Log lines become messages in the Log conversation; problems make its sidebar entry light up."""
        text = record.getMessage()
        if record.name != APP:
            text = f'{record.name.split(".")[-1]}: {text}'
        if record.levelno >= logging.WARNING:
            text = f'{record.levelname}: {text}'
        problem = record.levelno >= logging.WARNING or (record.name == APP and theme_is_problem(text))
        now = int(record.created)
        for line in text.splitlines() or ['']:
            self.add(LOG_KEY, Msg(now, '', line, recv=now), unread=problem)

    def connection_text(self) -> str:
        if self.connecting:
            return f'connecting to {self.target()}...'
        return f'connected to {self.target()}' if self.mc else 'disconnected'

    def select(self, key: tuple):
        self.selected = key
        self.cursor = None
        if self.focus == 'msgs':
            self.focus = 'side'
        self.unread.pop(key, None)
        self.scroll = 0
        self.dirty = True

    GROUPS = ('Channels', 'Contacts', 'Repeaters', 'Console')

    def groups(self) -> dict:
        """The conversations of each list group: {'Channels': [(key, name)], 'Contacts': ..., 'Repeaters': ..., 'Console': ...}."""
        ents = self.entries()
        n_ch = len(self.channels)
        rest = ents[n_ch:-2]
        return {'Channels': ents[:n_ch], 'Contacts': [(k, n) for k, n in rest if not self.is_infra(k)],
                'Repeaters': [(k, n) for k, n in rest if self.is_infra(k)], 'Console': ents[-2:]}

    def side_rows(self) -> list[tuple[str, tuple, int]]:
        """The visible rows of the list: (label, key, unread). Headings are ('h', name) keys; the cursor can sit on
        them and Enter folds the group, so a long contact list can be put away."""
        groups = self.groups()
        rows = []
        for name in self.GROUPS:
            items = groups[name]
            if name == 'Repeaters' and not items:
                continue
            if name in self.collapsed:
                rows.append((f'+ {name}', ('h', name), sum(self.unread.get(k, 0) for k, _ in items)))
            else:
                rows.append((f'- {name}' + (' (fav)' if name == 'Contacts' and self.fav_only else ''), ('h', name), 0))
                rows += [(n, k, self.unread.get(k, 0)) for k, n in items]
        return rows

    def group_lines(self, name: str) -> list[tuple[str, int]]:
        """What the message pane shows while the list cursor is on a heading: the group, not the open conversation."""
        items = self.groups().get(name, [])
        unread = sum(self.unread.get(k, 0) for k, _ in items)
        out = [(name, theme_HEAD), ('', 0)]
        noun = {'Channels': 'channel', 'Contacts': 'contact', 'Repeaters': 'repeater / room', 'Console': 'view'}.get(name, 'item')
        out.append((f'{len(items)} {noun}{"" if len(items) == 1 else "s"}' + (f', {unread} unread' if unread else ''), 0))
        if name == 'Contacts':
            favs = sum(1 for k, _ in items if k[0] == 'd' and k[1] in self.favorites)
            out.append((f'{favs} favorite{"" if favs == 1 else "s"} · sorted by {self.SORTS[self.contact_sort]}'
                        + (' · favorites only' if self.fav_only else ''), 0))
        elif name == 'Console':
            out.append(('Log: status messages, Radio: every packet heard', 0))
        out.append(('', 0))
        out.append(('Enter  ' + ('unfold' if name in self.collapsed else 'fold') + ' this group', curses.A_DIM))
        out.append(('F6     actions for the whole group', curses.A_DIM))
        out.append(('Down   ' + ('to the next heading' if name in self.collapsed or not items else 'on to the first ' + noun), curses.A_DIM))
        return out

    def group_of(self, key) -> str | None:
        if key is None:
            return None
        if key[0] == 'c':
            return 'Channels'
        if key in (LOG_KEY, RX_KEY):
            return 'Console'
        return 'Repeaters' if self.is_infra(key) else 'Contacts'

    def list_cursor(self, keys: list) -> tuple | None:
        """The row the list cursor is on: a heading, the open conversation, or (when that sits in a folded group) the
        heading of its group."""
        cur = self.cursor_header() or self.selected
        if cur not in keys:
            grp = self.group_of(cur)
            cur = ('h', grp) if ('h', grp) in keys else (keys[0] if keys else None)
        return cur

    def prev_item(self) -> bool:
        """Esc in the list: back to the row above; False on the first row."""
        keys = [k for _, k, _ in self.side_rows()]
        cur = self.list_cursor(keys)
        if cur not in keys or keys.index(cur) == 0:
            return False
        self.goto(keys[keys.index(cur) - 1])
        return True

    def next_item(self) -> bool:
        """Tab in the list: on to the next row, headings and conversations alike; False after the last row."""
        keys = [k for _, k, _ in self.side_rows()]
        cur = self.list_cursor(keys)
        if cur not in keys:
            return False
        i = keys.index(cur)
        if i + 1 >= len(keys):
            return False
        self.goto(keys[i + 1])
        return True

    def cursor_header(self) -> tuple | None:
        """The heading under the list cursor, if it is on one (and that heading is still there)."""
        if self.cursor and self.cursor[0] == 'h' and any(k == self.cursor for _, k, _ in self.side_rows()):
            return self.cursor
        return None

    def toggle_group(self, name: str):
        self.collapsed ^= {name}
        self.save_config()
        self.dirty = True

    def goto(self, key: tuple):
        """Put the list cursor on a row: a conversation is opened (and marked read), a heading is only marked."""
        if key[0] == 'h':
            self.cursor = key
            if self.focus == 'msgs':
                self.focus = 'side'
            self.dirty = True
        else:
            self.select(key)

    def move(self, delta: int, headings: bool = True):
        """Next / previous row of the list; while typing (headings=False) only conversations count."""
        rows = [r for r in self.side_rows() if headings or r[1][0] != 'h']
        if not rows:
            return
        keys = [k for _, k, _ in rows]
        cur = (self.cursor_header() if headings else None) or (self.selected if self.selected in keys else None)
        i = keys.index(cur) if cur in keys else (-1 if delta > 0 else len(keys))
        self.goto(keys[max(0, min(len(keys) - 1, i + delta))])

    def contacts(self) -> dict:
        return self.mc.contacts if self.mc else self.contact_cache

    def target(self) -> str:
        return f'radio on {REMOTE.split("@")[-1]}' if REMOTE else f'radio on {SERIAL}' if SERIAL else 'local radio'

    def need_radio(self) -> bool:
        if self.mc is None:
            self.status = 'not connected'
            self.dirty = True
            return False
        return True

    def note(self, text: str):
        """Local-only line in the current conversation (never sent)."""
        self.history.setdefault(self.selected, []).append(
            Msg(0, '*', text, mine=True))
        self.scroll = 0
        self.dirty = True

    def hop_name(self, h: str) -> str:
        """Name for a path hash (repeaters preferred, since those are what relay)."""
        hits = [c for c in self.contacts().values() if c['public_key'].startswith(h.lower())]
        hits.sort(key=lambda c: c.get('type') != 2)
        return f'{hits[0]["adv_name"]} ({h})' if hits else h

    @staticmethod
    def hops_of(path_hex: str, n: int, size: int = 1) -> list[str]:
        """The n hops of a stored path, `size` bytes (2 hex characters each) per hop."""
        return [path_hex[i:i + 2 * size] for i in range(0, n * 2 * size, 2 * size)]

    def show(self, title: str, lines: list[str]):
        if self.details is None or title != self.details_title:
            self.details_scroll = 0
        if self.menu_origin:                     # opened from a context menu: Esc returns there
            self.details_back, self.menu_origin = self.menu_origin, None
        elif self.details is None:
            self.details_back = None
        self.details_title, self.details = title, lines
        self.dirty = True

    async def guarded(self, coro):
        try:
            await coro
        except asyncio.CancelledError:
            raise
        except Exception as e:
            log.exception('action failed')
            self.status = f'failed: {e}'
            self.dirty = True


# ======================================================================
# daemon: owns the radio and shares it between any number of chat windows
# ======================================================================
#
# The daemon starts meshcore-pi (and the 5V supply) and is its one and only client. Every chat window connects to
# the daemon, which speaks the same companion protocol: requests are passed on one at a time and the answer goes to
# whoever asked, pushes (adverts, acks, the RX log, ...) go to every window. The radio's message queue is meant for a
# single reader, so the daemon empties it itself and gives each window its own copy; messages that arrive while no
# window is open are kept and handed to the next one. The daemon stops when the last window has been gone for a
# while (or never, with /keep on).

DAEMON_PORT = int(os.environ.get('CARDPUTER_MC_PORT', '5001'))
DAEMON_PID = os.path.join(HOME_DIR, 'daemon.pid')
STOP_MARK = os.path.join(HOME_DIR, 'stop-requested')
INBOX_FILE = os.path.join(HOME_DIR, 'inbox.json')
DAEMON_LOG = os.path.join(HOME_DIR, 'daemon.log')
IDLE_FIRST, IDLE_GRACE = 60.0, 20.0         # seconds without a window: before the first one, and after the last
REQUEST_TIMEOUT = 10.0                      # how long the radio gets to answer one request
MSG_FRAMES = (7, 8, 16, 17)                 # a message, as an answer to "next message" (old and v3 formats)


def _wire(prefix: bytes, payload: bytes) -> bytes:
    return prefix + len(payload).to_bytes(2, 'little') + payload


async def _read_frame(reader, prefix: bytes) -> bytes:
    """One companion frame: '<' (to the radio) or '>' (from it), a 2-byte length, the payload."""
    while True:
        while await reader.readexactly(1) != prefix:
            pass
        payload = await reader.readexactly(int.from_bytes(await reader.readexactly(2), 'little'))
        if payload:
            return payload


def _keep_daemon() -> bool:
    return bool(load_config().get('keep_daemon'))


SOUND_MODES = ('off', 'private', 'all')
STATUS_FILE = os.path.join(HOME_DIR, 'daemon.status')
SOUND_DIR = os.path.join(HOME_DIR, 'sounds')


def set_setting(name: str, value):
    """Change one key of the shared config file (read-modify-write, so other settings and other windows are not touched)."""
    cfg = load_config()
    cfg[name] = value
    try:
        os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
        with open(CONFIG_FILE + '.tmp', 'w') as f:
            json.dump(cfg, f, indent=1)
        os.replace(CONFIG_FILE + '.tmp', CONFIG_FILE)
    except OSError as e:
        log.warning('could not save the settings: %s', e)


def sound_mode() -> str:
    mode = load_config().get('sound', 'private')
    return mode if mode in SOUND_MODES else 'private'


def sound_device() -> list:
    """aplay arguments for the CardputerZero's own codec (the first sound card that is not HDMI)."""
    dev = os.environ.get('CARDPUTER_MC_SOUND_DEVICE')
    if dev:
        return [] if dev == 'default' else ['-D', dev]
    try:
        with open('/proc/asound/cards') as f:
            for line in f:
                m = re.match(r'\s*(\d+)\s+\[(\S+)\s*\]', line)
                if m and 'hdmi' not in m.group(2).lower():
                    return ['-D', f'plughw:{m.group(1)},0']
    except OSError:
        pass
    return []


def chime_file(kind: str) -> str:
    """A wav for a private message (a short low tone, then a longer one an octave up) or a channel message (one low tone); made on first use.
    The codec needs a moment to wake up, so the file starts with silence (without it a short beep is swallowed)."""
    import wave, struct
    path = os.path.join(SOUND_DIR, f'{kind}-5.wav')
    if not os.path.exists(path):
        os.makedirs(SOUND_DIR, exist_ok=True)
        rate = 48000
        out = [0] * int(rate * 0.7)
        for freq, dur in (((740, 0.11), (1480, 0.2)) if kind == 'private' else ((587, 0.25),)):      # private: "tu-DUU", low then an octave up
            n = int(rate * dur)
            fade = n // 4                                     # a short tone must not be mostly fade
            out += [int(26000 * min(1, i / 150, (n - i) / min(2000, fade)) * math.sin(2 * math.pi * freq * i / rate)) for i in range(n)]
        out += [0] * int(rate * 0.1)
        with wave.open(path, 'wb') as w:
            w.setnchannels(2)
            w.setsampwidth(2)
            w.setframerate(rate)
            w.writeframes(b''.join(struct.pack('<hh', v, v) for v in out))
    return path


def play_chime_now(kind: str = 'private') -> str | None:
    """Play a chime and wait for it (the `sound test`); returns an error text, or None."""
    try:
        r = subprocess.run(['aplay', '-q'] + sound_device() + [chime_file(kind)], capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        return 'aplay not found (install alsa-utils)'
    except (OSError, subprocess.SubprocessError) as e:
        return str(e)
    return r.stderr.strip() or None if r.returncode else None


class _Client:
    def __init__(self, reader, writer):
        self.reader, self.writer = reader, writer
        self.queue: collections.deque = collections.deque()      # messages this window has not fetched yet

    def send(self, payload: bytes):
        if self.writer.is_closing():
            return
        if self.writer.transport.get_write_buffer_size() > 1 << 20:      # a window that stopped reading
            self.writer.close()
            return
        self.writer.write(_wire(b'>', payload))


def persist_txpower(dbm: int):
    """Write the TX power into meshcore-pi's config, so it survives a restart of the radio."""
    try:
        with open(PI_CONFIG) as f:
            text = f.read()
        new, n = re.subn(r'(?m)^txpower\s*=.*$', f'txpower = {dbm}', text)
        if n:
            tmp = PI_CONFIG + '.tmp'
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w') as f:
                f.write(new)
            os.replace(tmp, PI_CONFIG)
            log.info('TX power %d dBm saved in %s', dbm, PI_CONFIG)
    except OSError as e:
        log.warning('could not save the TX power: %s', e)


class Daemon:
    def __init__(self, upstream=None):
        self.upstream = upstream              # (host, port) of a companion to use as is (tests); else run meshcore-pi
        self.radio = None if (upstream or SERIAL) else LocalRadio()
        self.clients: set = set()
        self.inbox: collections.deque = collections.deque(self._load_inbox())     # messages nobody has fetched
        self.lock = asyncio.Lock()            # one request to the radio at a time
        self.responses: asyncio.Queue = asyncio.Queue()
        self.wake_drain = asyncio.Event()
        self.stopping = asyncio.Event()
        self.up_reader = self.up_writer = None
        self.had_client = False
        self.idle_since = time.time()
        self.started = time.time()
        self.last_chime = 0.0
        self.no_sound = False
        self.sock = None

    # ---- messages nobody has picked up yet, kept across a restart of the daemon
    @staticmethod
    def _load_inbox() -> list:
        try:
            with open(INBOX_FILE) as f:
                return [bytes.fromhex(h) for h in json.load(f)]
        except (OSError, ValueError):
            return []

    def _save_inbox(self):
        try:
            with open(INBOX_FILE + '.tmp', 'w') as f:
                json.dump([b.hex() for b in self.inbox], f)
            os.replace(INBOX_FILE + '.tmp', INBOX_FILE)
        except OSError as e:
            log.warning('could not save the inbox: %s', e)

    # ---- the radio
    async def _request(self, payload: bytes) -> list:
        """Send one request upstream (the lock is held) and return its answer frames (several for the contact list)."""
        while not self.responses.empty():
            self.responses.get_nowait()       # a late answer to an earlier request must not be taken for this one
        self.up_writer.write(_wire(b'<', payload))
        try:
            frame = await asyncio.wait_for(self.responses.get(), REQUEST_TIMEOUT)
            frames = [frame]
            if frame[0] == 2:                 # start of the contact list: everything up to its end
                while frame[0] != 4:
                    frame = await asyncio.wait_for(self.responses.get(), REQUEST_TIMEOUT)
                    frames.append(frame)
            return frames
        except asyncio.TimeoutError:
            return []

    async def _read_upstream(self):
        try:
            while True:
                frame = await _read_frame(self.up_reader, b'>')
                if frame[0] < 0x80:
                    self.responses.put_nowait(frame)
                elif frame[0] == 0x83:        # messages waiting: we collect them ourselves
                    self.wake_drain.set()
                else:                         # any other push goes to every window
                    for c in list(self.clients):
                        c.send(frame)
        except (asyncio.IncompleteReadError, ConnectionError, OSError) as e:
            log.error('lost the connection to meshcore-pi (%s)', e or 'closed')
        self.stopping.set()

    async def _drain_loop(self):
        while True:
            await self.wake_drain.wait()
            self.wake_drain.clear()
            async with self.lock:
                while True:
                    frames = await self._request(b'\x0a')                 # next message
                    if frames and frames[0][0] in MSG_FRAMES:
                        self._deliver(frames[0])
                    else:
                        break

    def _chime(self, frame: bytes):
        """A sound for a new message: private (two tones) or channel (one tone), by the /sound setting; none while a window is open."""
        mode = sound_mode()
        private = frame[0] in (7, 16)
        if mode == 'off' or (mode == 'private' and not private):
            return
        txt_type = frame[11] if frame[0] == 16 else frame[8] if frame[0] == 7 else 0
        now = time.time()
        if self.clients:                     # a window is open: you are looking at it, so no chime
            return
        if txt_type != 0 or now - self.last_chime < 2.0 or self.no_sound:      # repeater replies and bursts stay quiet
            return
        self.last_chime = now

        async def play():
            try:
                proc = await asyncio.create_subprocess_exec('aplay', '-q', *sound_device(), chime_file('private' if private else 'channel'),
                                                            stdin=asyncio.subprocess.DEVNULL, stdout=asyncio.subprocess.DEVNULL,
                                                            stderr=asyncio.subprocess.DEVNULL)
                await proc.wait()
            except (OSError, ValueError) as e:
                log.warning('no sound: %s', e)
                self.no_sound = True
        asyncio.create_task(play())

    def _write_status(self):
        try:
            with open(STATUS_FILE + '.tmp', 'w') as f:
                json.dump({'pid': os.getpid(), 'started': self.started, 'written': time.time(), 'windows': len(self.clients),
                           'inbox': len(self.inbox)}, f)
            os.replace(STATUS_FILE + '.tmp', STATUS_FILE)
        except OSError:
            pass

    def _deliver(self, frame: bytes):
        self._chime(frame)
        if self.clients:
            for c in list(self.clients):
                c.queue.append(frame)
                c.send(b'\x83')               # messages waiting
        else:
            self.inbox.append(frame)
            self._save_inbox()

    # ---- the windows
    async def _on_client(self, reader, writer):
        client = _Client(reader, writer)
        self.clients.add(client)
        self.had_client = True
        log.info('window connected (%d now)', len(self.clients))
        if self.inbox:                        # what came in while nobody was there
            client.queue.extend(self.inbox)
            self.inbox.clear()
            self._save_inbox()
            client.send(b'\x83')
        try:
            while True:
                payload = await _read_frame(reader, b'<')
                if payload[0] == 10:          # next message: from this window's own copy
                    client.send(client.queue.popleft() if client.queue else b'\x0a')
                    continue
                async with self.lock:
                    frames = await self._request(payload)
                    for frame in frames:
                        client.send(frame)
                    if payload[0] == 12 and frames and frames[0][0] == 0:      # TX power set: remember it for the next start
                        await asyncio.to_thread(persist_txpower, int.from_bytes(payload[1:5], 'little', signed=True))
        except (asyncio.IncompleteReadError, ConnectionError, OSError):
            pass
        finally:
            self.clients.discard(client)
            writer.close()
            if not self.clients:
                if client.queue:              # the last window left with unread messages: keep them for the next one
                    self.inbox.extendleft(reversed(client.queue))
                    self._save_inbox()
                self.idle_since = time.time()
            log.info('window gone (%d left)', len(self.clients))

    async def _housekeeping(self):
        ticks = 0
        while True:
            await asyncio.sleep(2)
            ticks += 1
            self._write_status()
            if ticks % 15 == 0:               # meshcore-pi drops a client that stays silent for 90 s
                async with self.lock:
                    await self._request(b'\x14')                          # battery
            if ticks % 15 == 7:
                self.wake_drain.set()         # in case a "messages waiting" push got lost
            if not self.clients and not _keep_daemon():
                grace = IDLE_GRACE if self.had_client else IDLE_FIRST
                if time.time() - self.idle_since > grace:
                    log.info('no window for %.0f s: stopping', grace)
                    self.stopping.set()

    async def run(self) -> int:
        self.sock = socket.socket()
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.sock.bind((HOST, DAEMON_PORT))
        except OSError:
            log.error('port %d is in use: another daemon is running', DAEMON_PORT)
            return 1
        os.makedirs(HOME_DIR, exist_ok=True)
        with open(DAEMON_PID, 'w') as f:
            f.write(str(os.getpid()))
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(sig, self.stopping.set)
        tasks, server, rc = [], None, 0
        try:
            if self.radio:
                await self.radio.start()
            if SERIAL:                        # a USB companion speaks the same frames as meshcore-pi, over a serial line
                try:
                    import serial_asyncio_fast as serial_asyncio      # what recent meshcore versions use
                except ImportError:
                    import serial_asyncio
                self.up_reader, self.up_writer = await serial_asyncio.open_serial_connection(url=SERIAL, baudrate=115200)
                log.info('using the USB companion on %s', SERIAL)
                await asyncio.sleep(1.5)      # opening the port can reset the board
            else:
                host, port = self.upstream or (HOST, PORT)
                self.up_reader, self.up_writer = await asyncio.open_connection(host, port)
            tasks.append(asyncio.create_task(self._read_upstream()))
            async with self.lock:
                for _ in range(3 if SERIAL else 1):
                    hello = await self._request(b'\x01\x03      cmcd')    # app start
                    if hello and hello[0][0] == 5:
                        break
                if not hello or hello[0][0] != 5:
                    raise RuntimeError('the radio did not answer')
                await self._request(b'\x16\x03')                           # device query: protocol 3 (SNR with messages)
            tasks += [asyncio.create_task(self._drain_loop()), asyncio.create_task(self._housekeeping())]
            self.wake_drain.set()
            self.sock.listen(8)               # until now the windows were refused
            server = await asyncio.start_server(self._on_client, sock=self.sock)
            log.info('radio daemon ready on %s:%d', HOST, DAEMON_PORT)
            await self.stopping.wait()
        except Exception:
            log.exception('radio daemon failed')
            rc = 1
        finally:
            for t in tasks:
                t.cancel()
            if server is not None:
                server.close()
            for c in list(self.clients):
                c.writer.close()
            if self.up_writer is not None:
                self.up_writer.close()
            if self.radio:
                await self.radio.stop()
            self.sock.close()
            try:
                os.remove(DAEMON_PID)
            except OSError:
                pass
            log.info('radio daemon stopped')
        return rc


def daemon_pid():
    """pid of the running daemon, or None."""
    try:
        with open(DAEMON_PID) as f:
            pid = int(f.read())
        with open(f'/proc/{pid}/cmdline', 'rb') as f:
            args = f.read().decode(errors='replace').split('\0')
        return pid if 'daemon' in args else None
    except (OSError, ValueError):
        return None


REMOTE = None                      # [user@]host of the machine that has the radio (set by --remote), else None
SERIAL = os.environ.get('CARDPUTER_MC_SERIAL') or None     # serial port of a USB companion (a Heltec ...), set by --serial
REMOTE_PORT = int(os.environ.get('CARDPUTER_MC_REMOTE_PORT', '5001'))
TUNNEL = None


def _port_open(port: int) -> bool:
    try:
        with socket.create_connection((HOST, port), 1):
            return True
    except OSError:
        return False


def open_tunnel(host: str):
    """--remote: start the radio daemon on `host` (over ssh) and forward its port to this machine. The daemon has no
    password, so it only listens on its own localhost; the ssh login is what protects it."""
    global REMOTE, TUNNEL
    REMOTE = host
    if _port_open(DAEMON_PORT):
        return                                        # already forwarded (an open window's tunnel)
    ssh = ['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10']
    try:
        r = subprocess.run(ssh + [host, f'~/.local/bin/{APP} up'], capture_output=True, text=True, timeout=150)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise RuntimeError(f'ssh to {host} failed: {e}')
    if r.returncode != 0:
        raise RuntimeError(f'could not start the radio on {host}: {(r.stderr or r.stdout).strip()[-300:]}')
    TUNNEL = subprocess.Popen(ssh + ['-N', '-o', 'ExitOnForwardFailure=yes', '-o', 'ServerAliveInterval=15',
                                     '-L', f'{HOST}:{DAEMON_PORT}:{HOST}:{REMOTE_PORT}', host],
                              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                              preexec_fn=_die_with_parent)
    atexit.register(lambda: TUNNEL.poll() is None and TUNNEL.terminate())
    for _ in range(40):
        if _port_open(DAEMON_PORT):
            return
        if TUNNEL.poll() is not None:
            raise RuntimeError(f'ssh tunnel to {host} failed: {TUNNEL.stderr.read().decode(errors="replace").strip()[-300:]}')
        time.sleep(0.25)
    raise RuntimeError(f'ssh tunnel to {host} did not come up')


async def daemon_reachable() -> bool:
    try:
        _, writer = await asyncio.wait_for(asyncio.open_connection(HOST, DAEMON_PORT), 2)
    except (OSError, asyncio.TimeoutError):
        return False
    writer.close()
    return True


async def ensure_daemon():
    """Make sure the radio daemon is up, starting it (detached, so it outlives this window) when it is not."""
    if await daemon_reachable():
        return
    if REMOTE:
        await asyncio.to_thread(open_tunnel, REMOTE)
        if await daemon_reachable():
            return
        raise RuntimeError(f'radio on {REMOTE} not reachable')
    if SERIAL:
        if not os.path.exists(SERIAL):
            raise RuntimeError(f'no such serial port: {SERIAL}')
    elif not available():
        raise RuntimeError(f'local radio not available (need {SPIDEV}); run: {APP} install')
    try:
        os.remove(STOP_MARK)
    except OSError:
        pass
    os.makedirs(HOME_DIR, exist_ok=True)
    start_at = os.path.getsize(DAEMON_LOG) if os.path.exists(DAEMON_LOG) else 0
    with open(DAEMON_LOG, 'ab') as out:
        proc = subprocess.Popen([PI_PYTHON, os.path.realpath(__file__), 'radio', 'daemon'], cwd=HOME_DIR, stdin=subprocess.DEVNULL,
                                stdout=out, stderr=out, start_new_session=True)
    loop = asyncio.get_running_loop()
    deadline = loop.time() + START_TIMEOUT + 15
    while loop.time() < deadline:
        await asyncio.sleep(0.4)
        if await daemon_reachable():
            return
        if proc.poll() is not None:
            raise RuntimeError(f'radio daemon exited ({proc.returncode}): {_tail(DAEMON_LOG, start_at)}')
    raise RuntimeError('radio daemon did not start in time')


def stop_requested() -> bool:
    """True just after `cardputer-mc radio stop`: the windows must not start the radio again."""
    try:
        return time.time() - os.path.getmtime(STOP_MARK) < 30
    except OSError:
        return False


def stop_daemon_quietly() -> tuple:
    """Stop the radio daemon; (exit code, message)."""
    pid = daemon_pid()
    if pid is None:
        return 0, 'the radio daemon is not running'
    with open(STOP_MARK, 'w'):
        pass
    os.kill(pid, signal.SIGTERM)
    for _ in range(100):
        time.sleep(0.1)
        if daemon_pid() is None:
            return 0, 'radio daemon stopped; the radio is off'
    return 1, f'the radio daemon (pid {pid}) did not stop within 10 s'


def stop_daemon() -> int:
    rc, message = stop_daemon_quietly()
    print(message)
    return rc


def daemon_status() -> int:
    pid = daemon_pid()
    if not pid:
        print('radio daemon: not running')
        return 1
    st = {}
    try:
        with open(STATUS_FILE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        pass
    up = ''
    if st.get('pid') == pid and time.time() - st.get('written', 0) < 30:
        secs = int(time.time() - st['started'])
        up = f', up {secs // 3600}h{secs % 3600 // 60:02d}m' if secs >= 3600 else f', up {secs // 60}m{secs % 60:02d}s'
    print(f'radio daemon: running (pid {pid}{up}), keep running when closed: {"on" if _keep_daemon() else "off"}')
    if up:
        print(f'windows: {st.get("windows", 0)}   inbox: {st.get("inbox", 0)} waiting   sound: {sound_mode()}')
    return 0


