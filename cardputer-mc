        if self.noise_unsupported or (self.mc is not None and not self.noise_hist):
            self.noise_unsupported = False
            self.noise_misses = 0
            asyncio.create_task(self.guarded(self.sample_noise()))

    def draw_noise(self, scr, h, w):
        """The noise floor over the last minutes as a bar graph in the message pane: more bars = more noise (less negative dBm).
        It follows the size of that pane, so a bigger terminal shows a taller and wider graph (more minutes)."""
        sw = self.sidebar_width(w)
        x0, bw = sw + 2, w - sw - 3
        y0, bh = 1, h - 3
        if bw < 12 or bh < 4:
            return
        for y in range(bh):
            scr.addstr(y0 + y, sw + 1, blank(w - sw - 1))
        scr.addnstr(y0, x0, 'Noise floor (dBm)', bw, curses.A_BOLD)
        rows = bh - 3
        hist = list(self.noise_hist)
        if not hist:
            msg = 'this radio does not report its noise floor' if self.noise_unsupported else 'measuring...'
            scr.addnstr(y0 + 2, x0, msg, bw)
        else:
            vals = hist[-(bw - 5):]
            lo, hi = min(vals), max(vals)
            lo = min(lo, hi - 6)                                  # a flat line must stay flat
            lo, hi = lo - 1, hi + 1
            cells = [min(rows * 8, max(1, round((v - lo) / (hi - lo) * rows * 8))) for v in vals]
            ascii_only = not (getattr(sys.stdout, 'encoding', None) or '').lower().startswith('utf')
            for r in range(rows):                                 # top row first
                base = (rows - 1 - r) * 8
                line = ''.join(' ' if c <= base else '#' if ascii_only else SPARK[min(7, c - base - 1)] for c in cells)
                label = f'{hi:4.0f}' if r == 0 else f'{lo:4.0f}' if r == rows - 1 else f'{(lo + hi) / 2:4.0f}' if r == rows // 2 and rows >= 5 else '    '
                scr.addnstr(y0 + 1 + r, x0, f'{label} {line}'.replace(' ', NBSP), bw)
            summary = f'now {hist[-1]:.0f}  min {min(hist):.0f}  avg {sum(hist) / len(hist):.0f}  max {max(hist):.0f}   {len(vals) * NOISE_EVERY // 60} min'
            if len(summary) > bw:
                summary = f'now {hist[-1]:.0f} min {min(hist):.0f} max {max(hist):.0f}'
            scr.addnstr(y0 + rows + 1, x0, summary, bw, curses.A_BOLD)
        scr.addnstr(y0 + bh - 1, x0, 'higher = noisier · any key closes' if bw >= 34 else 'any key closes', bw, curses.A_DIM)
        curses.curs_set(0)


