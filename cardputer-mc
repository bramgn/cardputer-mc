async def cmd_ping(a) -> int:
    """Zero-hop traces to a repeater or room server, like ping(8): one line per try, then a summary."""
    app = await cli_app()
    try:
        key, name = resolve_target(app, a.target)
        c = next((c for k, _, c in cli_contacts(app) if k == key), None) if key[0] == 'd' else None
        if c is None:
            raise CliError(f'{name} is a channel: only repeaters and room servers can be pinged', 2)
        if c.get('type') not in (2, 3):
            raise CliError(f'{name} is a normal client: only repeaters and room servers answer a ping '
                           f'(use `{APP} send` to test a client: the acknowledgement is the proof)', 2)
        print(f'PING {name} ({c["public_key"][:8]}), zero hop')
        times, sent = [], 0
        stop = asyncio.Event()
        asyncio.get_running_loop().add_signal_handler(signal.SIGINT, stop.set)      # Ctrl-C: stop, then print the summary
        while not stop.is_set() and (a.count == 0 or sent < a.count):
            if sent:
                try:
                    await asyncio.wait_for(stop.wait(), a.interval)
                except asyncio.TimeoutError:
                    pass
                if stop.is_set():
                    break
            sent += 1
            ms, snrs, why = await app.ping_once(c)
            now = datetime.now().strftime('%H:%M:%S')
            if ms is None:
                print(f'{now} seq={sent} {why}', flush=True)
            else:
                times.append(ms)
                print(f'{now} seq={sent} time={ms:.0f} ms snr={" ".join(f"{x:.2f}" for x in snrs)} dB', flush=True)
        lost = sent - len(times)
        print(f'--- {name} ping statistics ---')
        print(f'{sent} sent, {len(times)} received, {100 * lost // max(sent, 1)}% lost')
        if times:
            print(f'round trip min/avg/max = {min(times):.0f}/{sum(times) / len(times):.0f}/{max(times):.0f} ms')
        return 0 if times else 1
    finally:
        await cli_finish(app)


NOISE_EVERY = 5               # seconds between noise floor readings
NOISE_KEEP = 360              # readings kept: 30 minutes
SPARK = '\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588'
SPARK_ASCII = '_.-~^'


def sparkline(values, lo, hi, ascii_only=False) -> str:
    """One character per value, scaled between lo and hi (dBm)."""
    chars = SPARK_ASCII if ascii_only else SPARK
    span = max(hi - lo, 1)
    return ''.join(chars[min(len(chars) - 1, max(0, int((v - lo) / span * len(chars))))] for v in values)


async def read_noise(app):
    """(noise floor dBm, last rssi, last snr) from the radio, or None when it does not say."""
    r = await app.mc.commands.get_stats_radio()
    if r.type == EventType.ERROR:
        return None
    p = r.payload
    return p.get('noise_floor'), p.get('last_rssi'), p.get('last_snr')


async def cmd_noise(a) -> int:
    """The noise floor of the radio (dBm): one reading, or a live graph with --watch."""
    app = await cli_app()
    try:
        first = await read_noise(app)
        if first is None:
            raise CliError('the radio does not report its noise floor (not yet measured, or an older companion)')
        if not a.watch:
            nf, rssi, snr = first
            print(f'noise floor {nf} dBm, last packet rssi {rssi} dBm snr {snr} dB')
            return 0
        stop = asyncio.Event()
        asyncio.get_running_loop().add_signal_handler(signal.SIGINT, stop.set)
        width = max(10, min(shutil.get_terminal_size().columns - 28, 120))
        history, n = [first[0]], 0
        while not stop.is_set() and (a.count == 0 or n < a.count):
            try:
                await asyncio.wait_for(stop.wait(), a.interval)
            except asyncio.TimeoutError:
                pass
            if stop.is_set():
                break
            cur = await read_noise(app)
            if cur is None:
                continue
            n += 1
            history = (history + [cur[0]])[-width:]
            lo, hi = min(history), max(history)
            lo = min(lo, hi - 6)                      # never stretch a flat line into noise
            print(f'{datetime.now().strftime("%H:%M:%S")} {cur[0]:4d} dBm {sparkline(history, lo, hi, not sys.stdout.encoding or "utf" not in sys.stdout.encoding.lower())} {lo}..{hi}', flush=True)
        return 0
    finally:
        await cli_finish(app)


async def cmd_advert(a) -> int:
    app = await cli_app()
    try:
        r = await app.mc.commands.send_advert(flood=a.flood)
        if r.type == EventType.ERROR:
            raise CliError(f'advert failed: {describe_error(r.payload)}')
        print('advert sent' + (' (flood)' if a.flood else ''))
