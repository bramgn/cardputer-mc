    if not os.path.isfile(VENV_PY):
        _run([sys.executable, '-m', 'venv', VENV_DIR])
    _run([VENV_PY, '-m', 'pip', 'install', '--retries', '10', '--timeout', '60', '-q', 'meshcore'])
    print('2/2 command')
