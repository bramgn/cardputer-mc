UPDATE_CHECK_FILE = os.path.join(HOME_DIR, 'update.check')


def _git(repo: str, *args, timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(['git', '-C', repo, *args], capture_output=True, text=True, timeout=timeout)


def _repo_dir() -> str | None:
    """The git checkout this script runs from, or None (a copied file)."""
    d = os.path.dirname(os.path.realpath(__file__))
    try:
        return d if _git(d, 'rev-parse', '--is-inside-work-tree').stdout.strip() == 'true' else None
    except (OSError, subprocess.SubprocessError):
        return None


def update_available() -> str | None:
    """Short id of a newer commit on the public repository, or None. At most one look a day (git ls-remote, nothing is
    sent but the connection itself); CARDPUTER_MC_NO_UPDATE_CHECK=1 or "update_check": false in the config turns it off."""
    if os.environ.get('CARDPUTER_MC_NO_UPDATE_CHECK') or load_config().get('update_check') is False:
        return None
    repo = _repo_dir()
    if repo is None:
        return None
    try:
        with open(UPDATE_CHECK_FILE) as f:
            cached = json.load(f)
    except (OSError, ValueError):
        cached = {}
    if time.time() - cached.get('t', 0) > 86400 or not cached.get('sha'):
        try:
            out = _git(repo, 'ls-remote', UPDATE_REPO, f'refs/heads/{UPDATE_BRANCH}', timeout=10).stdout.split()
        except (OSError, subprocess.SubprocessError):
            return None
        if not out:
            return None
        cached = {'t': time.time(), 'sha': out[0]}
        try:
            os.makedirs(HOME_DIR, exist_ok=True)
            with open(UPDATE_CHECK_FILE, 'w') as f:
                json.dump(cached, f)
        except OSError:
            pass
    sha = cached['sha']
    if _git(repo, 'rev-parse', 'HEAD').stdout.strip() == sha or _git(repo, 'merge-base', '--is-ancestor', sha, 'HEAD').returncode == 0:
        return None                                   # we have it, or we are ahead of it
    return sha[:7]


def cmd_update(opts) -> int:
    """update: fetch the newest version, fast-forward this checkout, re-apply the meshcore-pi patches, and restart the
    radio daemon when no window is using it. update --check only looks."""
    repo = _repo_dir()
    if repo is None:
        print(f'{APP}: {os.path.realpath(__file__)} is not inside a git checkout; clone {UPDATE_REPO} to update it')
        return 1
    if opts.apply:                                    # second step, run by the new code after the merge
        if os.path.exists(COMPLETION_FILE):
            write_completion(build_parser())            # the commands may have changed
        if os.path.isdir(os.path.join(PI_DIR, '.git')):
            print('meshcore-pi fixes:')
            apply_pi_patches()
        pid = daemon_pid()
        if pid is None:
            print('the radio daemon is not running; the next start uses the new version')
            return 0
        try:
            with open(STATUS_FILE) as f:
                windows = json.load(f).get('windows', 0)
        except (OSError, ValueError):
            windows = 0
        if windows:
            print(f'the radio daemon (pid {pid}) keeps the old code until it restarts: close the {windows} window(s), '
                  f'then run: {APP} radio stop; {APP} radio up')
            return 0
        rc, message = stop_daemon_quietly()
        print(message)
        if rc == 0:
            try:
                asyncio.run(ensure_daemon())
                print('radio daemon restarted with the new version')
            except RuntimeError as e:
                print(f'could not restart the radio daemon: {e}')
                return 1
        return rc
    r = _git(repo, 'fetch', '-q', UPDATE_REPO, UPDATE_BRANCH, timeout=120)
    if r.returncode:
        print(f'{APP}: fetch failed: {r.stderr.strip() or "no network?"}')
        return 1
    local, remote = _git(repo, 'rev-parse', 'HEAD').stdout.strip(), _git(repo, 'rev-parse', 'FETCH_HEAD').stdout.strip()
    if local == remote or _git(repo, 'merge-base', '--is-ancestor', remote, local).returncode == 0:
        print(f'up to date ({local[:7]})' + ('' if local == remote else ', ahead of the published version'))
        return 0
    print('new:')
    print(_git(repo, 'log', '--format=  %h %s', f'{local}..{remote}').stdout.rstrip())
    if opts.check:
        return 10
    if _git(repo, 'status', '--porcelain', '--untracked-files=no').stdout.strip():
        print(f'{APP}: there are local changes in {repo}; commit or stash them first (nothing was changed)')
        return 1
    r = _git(repo, 'merge', '--ff-only', remote)
    if r.returncode:
        print(f'{APP}: cannot fast-forward ({r.stderr.strip() or r.stdout.strip()}); update by hand in {repo}')
        return 1
    print(f'updated {local[:7]} -> {remote[:7]}', flush=True)
    try:
        os.remove(UPDATE_CHECK_FILE)
    except OSError:
        pass
    os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), 'update', '--apply'])       # continue with the new code


