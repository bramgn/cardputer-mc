class CommandsMixin:
    # Words that make a line starting with ':' a command (":quit", ":help"), as with '/'. Single letters are left
    # out, apart from q, h and ?, so smileys such as ":D" and ":p" stay messages; "::" sends a literal ':'.
    COLON_COMMANDS = frozenset(('contact', 'ct', 'menu', 'actions', 'act', 'ping', 'info', 'reboot', 'theme', 'advert', 'find', 'search',
                                'trace', 'channel', 'ch', 'quit', 'exit', 'connect', 'disconnect', 'reload', 'options',
                                'settings', 'clear', 'cls', 'log', 'console', 'radio', 'rx', 'rxlog', 'repeaters',
                                'help', 'q', 'h', '?', 'keep', 'stop', 'sound'))
    COMMAND_NAMES = ('act', 'actions', 'advert', 'channel', 'clear', 'connect', 'contact', 'disconnect', 'help', 'info', 'log', 'menu', 'quit',
                     'reload', 'repeaters', 'ping', 'radio', 'noise', 'reboot', 'search', 'options', 'theme', 'trace', 'keep', 'stop', 'sound')

    def complete(self):
        """Tab completion for /commands in the input line."""
        if not self.buf.startswith(('/', ':')) or ' ' in self.buf or self.buf.startswith(('//', '::')):
            return
        pre = self.buf[0]
        cyc = getattr(self, '_tab', None)
        if cyc and self.buf == cyc[2]:                 # repeated Tab: next match
            hits, i = cyc[0], (cyc[1] + 1) % len(cyc[0])
        else:
            word = self.buf[1:].lower()
            hits, i = [c for c in self.COMMAND_NAMES if c.startswith(word)], -1
            if not hits:
                self.status = f'no command matches {pre}{word}'
                return
            common = os.path.commonprefix(hits)
            if len(hits) > 1 and common == word:       # nothing more to add: start cycling
                i = 0
            else:
                self.buf = pre + common
        if i >= 0:
            self.buf = pre + hits[i]
        self.pos = len(self.buf)
        self._tab = (hits, i, self.buf) if len(hits) > 1 else None
        if len(hits) > 1:
            self.status = 'matches: ' + '  '.join(pre + c for c in hits)

    async def submit(self, text: str):
        if not text:
            return
        if text.startswith(':') and not text.startswith('::') and text[1:].split(' ', 1)[0] in self.COLON_COMMANDS:
            text = '/' + text[1:]
        if not text.startswith('/') or text.startswith('//') or text.startswith('::'):
            await self.send(text[1:] if text.startswith(('//', '::')) else text)
            return
        name, _, arg = text[1:].partition(' ')
        name = name.lower()
        if name in ('contact', 'ct', 'menu', 'actions', 'act'):
            self.open_contact_menu()
            self.dirty = True
            return
        if name in ('p', 'ping'):
            self.ping_command(arg)
            self.dirty = True
            return
        if name in ('i', 'info'):
            if self.need_radio():
                await self.radio_info()
            self.dirty = True
            return
        if name == 'reboot':
            self.ask_reboot()
            return
        if name == 'theme':
            self.theme_command(arg)
            self.dirty = True
            return
        if name in ('a', 'advert'):
            kinds = {'': None, 'zero': False, 'zerohop': False, '0': False, 'flood': True}
            if arg.strip().lower() not in kinds:
                self.status = 'usage: /advert [zero|flood]'
            else:
                await self.advert(kinds[arg.strip().lower()])
            self.dirty = True
            return
        if name in ('f', 'find', 'search'):
            self.do_search(arg.strip())
            self.dirty = True
            return
        if name == 'keep':
            word = arg.strip().lower()
            if word not in ('', 'on', 'off'):
                self.status = 'usage: /keep [on|off]'
            else:
                self.keep_daemon = (not self.keep_daemon) if not word else word == 'on'
                self.save_config()
                self.status = ('the radio stays on when the last window closes (messages keep coming in; /stop switches it off)'
                               if self.keep_daemon else 'the radio switches off 20 s after the last window closes')
            self.dirty = True
            return
        if name == 'sound':
            word = arg.strip().lower()
            if word == 'test':
                err = await asyncio.to_thread(play_chime_now, 'private')
                self.status = err or 'played the chime'
            elif word not in ('',) + SOUND_MODES:
                self.status = 'usage: /sound [off|private|all|test]'
            else:
                if word:
                    self.sound = word
                self.status = {'off': 'sound off', 'private': 'sound on for private messages',
                               'all': 'sound on for private and channel messages'}[self.sound]
            self.dirty = True
            return
        if name == 'stop':
            self.keep_daemon = False
            self.save_config()
            rc, message = await asyncio.to_thread(stop_daemon_quietly)
            self.status = message
            self.quit = rc == 0
            self.dirty = True
            return
        if name in ('t', 'trace'):
            await self.trace_command(arg)
            self.dirty = True
            return
        if name in ('ch', 'channel'):
            await self.create_channel(arg.strip())
            self.dirty = True
            return
        cmds = {
            ('q', 'quit', 'exit'): lambda: setattr(self, 'quit', True),
            ('c', 'connect'): self.pick_device,
            ('d', 'disconnect'): self.disconnect,
            ('r', 'reload'): self.reload,
            ('o', 'options', 's', 'settings'): lambda: setattr(self, 'settings_open', True),
            ('clear', 'cls'): self.clear_current,
            ('l', 'log', 'console'): lambda: self.select(LOG_KEY),
            ('radio', 'rx', 'rxlog'): lambda: self.select(RX_KEY),
            ('repeaters',): lambda: setattr(self, 'show_repeaters', not self.show_repeaters),
            ('h', 'help', '?'): self.help,
            ('n', 'noise'): self.noise,
        }
        for names, fn in cmds.items():
            if name in names:
                r = fn()
                if asyncio.iscoroutine(r):
                    await r
                self.dirty = True
                return
        self.status = f'unknown command /{name} (try /help)'

    def clear_current(self, key=None):
        """Empty a conversation, by default the selected one (Log and Radio included). The clear mark makes the other
        windows, and the shared history file the next sync would merge back in, drop their copies too."""
        key = key or self.selected
        if key is None:
            return
        self.history[key] = []
        if key not in (RX_KEY, LOG_KEY):
            self.cleared[json.dumps(key)] = time.time()           # other windows drop their copies too
        self.unread.pop(key, None)
        self.msg_sel = self.scroll = 0
        if key != LOG_KEY:
            self.status = f'cleared {self.name_for(key)}'

